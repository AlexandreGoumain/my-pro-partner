// IMMOBILIER MODELS - Biens, Mandats, Visites

// ============================================
// AGENT IMMOBILIER - BIENS IMMOBILIERS
// ============================================

model BienImmobilier {
  id        String @id @default(cuid())
  reference String // Référence interne unique

  // Type et statut
  typeBien TypeBien
  statut   StatutBien @default(DISPONIBLE)

  // Transaction
  enVente      Boolean  @default(false)
  enLocation   Boolean  @default(false)
  prixVente    Decimal? @db.Decimal(12, 2)
  prixLocation Decimal? @db.Decimal(10, 2) // Loyer mensuel
  chargesLoc   Decimal? @db.Decimal(10, 2)

  // Localisation
  adresse    String
  codePostal String
  ville      String
  pays       String  @default("France")
  etage      Int?
  ascenseur  Boolean @default(false)
  latitude   Float?
  longitude  Float?

  // Caractéristiques
  surface       Decimal  @db.Decimal(10, 2) // m²
  nbPieces      Int
  nbChambres    Int?
  nbSallesBains Int?
  nbWc          Int?
  balcon        Boolean  @default(false)
  terrasse      Boolean  @default(false)
  jardin        Boolean  @default(false)
  surfaceJardin Decimal? @db.Decimal(10, 2)
  parking       Boolean  @default(false)
  garage        Boolean  @default(false)
  cave          Boolean  @default(false)
  piscine       Boolean  @default(false)

  // Construction
  anneeConstruction Int?
  etatGeneral       String? // Neuf, Bon, À rafraîchir, À rénover

  // DPE et diagnostics
  dpeConsommation  String? // A, B, C, D, E, F, G
  dpeEmission      String? // A, B, C, D, E, F, G
  datesDiagnostics DateTime?

  // Copropriété (si applicable)
  enCopropriete   Boolean  @default(false)
  nbLotsCopro     Int?
  chargesCopro    Decimal? @db.Decimal(10, 2)
  procedureSyndic Boolean  @default(false)

  // Description
  titre       String
  description String? @db.Text

  // Photos et médias
  photos    Json? // Array of URLs
  visite360 String? // URL visite virtuelle
  video     String? // URL vidéo

  // Propriétaire (peut être un client)
  proprietaire   Client? @relation("BiensProprietaire", fields: [proprietaireId], references: [id])
  proprietaireId String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  mandats     MandatImmobilier[]
  visites     VisiteImmobilier[]
  estimations EstimationBien[]
  diffusions  DiffusionAnnonce[]
  baux        BailLocatif[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, reference])
  @@index([entrepriseId])
  @@index([typeBien])
  @@index([statut])
  @@index([ville])
  @@index([prixVente])
  @@index([prixLocation])
}

// ============================================
// AGENT IMMOBILIER - MANDATS ET TRANSACTIONS
// ============================================

model MandatImmobilier {
  id     String @id @default(cuid())
  numero String // Numéro de mandat (registre)

  // Type et statut
  typeMandat TypeMandat
  statut     StatutMandat @default(EN_COURS)

  // Dates
  dateSignature DateTime
  dateDebut     DateTime
  dateFin       DateTime // Date d'expiration

  // Prix
  prixMandat  Decimal  @db.Decimal(12, 2) // Prix demandé
  prixMinimum Decimal? @db.Decimal(12, 2) // Prix minimum accepté

  // Honoraires
  tauxHonoraires Decimal  @db.Decimal(5, 2) // % honoraires
  honorairesHT   Decimal? @db.Decimal(10, 2)
  honorairesTTC  Decimal? @db.Decimal(10, 2)
  chargeVendeur  Boolean  @default(true) // true = vendeur, false = acquéreur

  // Bien concerné
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Propriétaire mandant
  mandant   Client @relation("MandatsClient", fields: [mandantId], references: [id])
  mandantId String

  // Agent en charge
  agent   Employee? @relation("MandatAgent", fields: [agentId], references: [id])
  agentId String?

  // Document signé
  documentSigneUrl String?

  // Notes
  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  visites VisiteImmobilier[]
  offres  OffreAchat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([statut])
  @@index([typeMandat])
  @@index([dateFin])
}

model VisiteImmobilier {
  id String @id @default(cuid())

  // Planification
  dateVisite DateTime
  duree      Int          @default(30) // minutes
  statut     StatutVisite @default(PLANIFIEE)

  // Bien visité
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Mandat (optionnel)
  mandat   MandatImmobilier? @relation(fields: [mandatId], references: [id])
  mandatId String?

  // Visiteur (acquéreur potentiel)
  visiteur   Client @relation("VisitesAcquereur", fields: [visiteurId], references: [id])
  visiteurId String

  // Agent accompagnateur
  agent   Employee? @relation("VisiteAgent", fields: [agentId], references: [id])
  agentId String?

  // Compte-rendu
  compteRendu   String? @db.Text
  interesseNote Int? // Note d'intérêt 1-5

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([dateVisite])
  @@index([statut])
  @@index([bienId])
  @@index([visiteurId])
}

model EstimationBien {
  id String @id @default(cuid())

  // Bien estimé
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Estimation
  prixEstimeBas  Decimal @db.Decimal(12, 2)
  prixEstimeHaut Decimal @db.Decimal(12, 2)
  prixRecommande Decimal @db.Decimal(12, 2)

  // Méthode
  methode     String? // Comparative, DCF, etc.
  comparables Json? // Biens comparables utilisés

  // Agent
  agent   Employee? @relation("EstimationAgent", fields: [agentId], references: [id])
  agentId String?

  // Document généré
  rapportUrl String?

  dateEstimation DateTime @default(now())
  validiteJours  Int      @default(90)

  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([bienId])
  @@index([dateEstimation])
}

model OffreAchat {
  id String @id @default(cuid())

  // Offre
  montant      Decimal     @db.Decimal(12, 2)
  dateOffre    DateTime    @default(now())
  dateValidite DateTime
  statut       StatutOffre @default(EN_ATTENTE)

  // Conditions
  conditions      String?  @db.Text // Conditions suspensives
  financement     String? // Type de financement
  apportPersonnel Decimal? @db.Decimal(12, 2)

  // Mandat concerné
  mandat   MandatImmobilier @relation(fields: [mandatId], references: [id])
  mandatId String

  // Acquéreur
  acquereur   Client @relation("OffresAcquereur", fields: [acquereurId], references: [id])
  acquereurId String

  // Réponse
  dateReponse       DateTime?
  contreProposition Decimal?  @db.Decimal(12, 2)
  motifRefus        String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([mandatId])
  @@index([statut])
}

// ============================================
// AGENT IMMOBILIER - DIFFUSION ANNONCES
// ============================================

// Configuration des portails (settings par entreprise)
model ConfigurationPortail {
  id String @id @default(cuid())

  portail PortailDiffusion
  actif   Boolean          @default(false)

  // Credentials (simulés pour l'instant)
  identifiant String?
  cleApi      String? // Encrypted
  agenceId    String? // ID agence sur le portail

  // Options de diffusion par défaut
  typeAnnonceDefaut  TypeAnnonce @default(STANDARD)
  dureeDefautJours   Int         @default(30)
  autoRenouvellement Boolean     @default(true)

  // Limites du compte (simulé)
  creditsDispo Int @default(100)
  annoncesMax  Int @default(50)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, portail])
  @@index([entrepriseId])
}

model DiffusionAnnonce {
  id String @id @default(cuid())

  // Bien diffusé
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Portail et type
  portail     PortailDiffusion
  typeAnnonce TypeAnnonce      @default(STANDARD)
  statut      StatutDiffusion  @default(BROUILLON)

  // Identifiants externes (comme si c'était réel)
  referenceExterne String? // ID sur le portail (ex: "SL-123456")
  urlAnnonce       String? // URL de l'annonce sur le portail

  // Contenu personnalisé par portail (peut différer du bien)
  titreAnnonce        String? // Titre spécifique au portail
  descriptionAnnonce  String? @db.Text // Description adaptée
  photosSelectionnees Json? // IDs des photos à diffuser (ordre spécifique)

  // Options payantes (simulées)
  optionBoost   Boolean @default(false)
  optionUrgent  Boolean @default(false)
  optionPhotoHD Boolean @default(false)
  coutCredits   Int     @default(1) // Coût en crédits

  // Statistiques (simulées avec des données réalistes)
  nbVues           Int      @default(0)
  nbVuesUniques    Int      @default(0)
  nbClicsContact   Int      @default(0)
  nbClicsTelephone Int      @default(0)
  nbFavoris        Int      @default(0)
  nbPartages       Int      @default(0)
  positionMoyenne  Decimal? @db.Decimal(5, 2) // Position dans les résultats

  // Statistiques par période (JSON)
  statsHebdo      Json? // { "2024-W01": { vues: 150, contacts: 5 }, ... }
  statsMensuelles Json? // { "2024-01": { vues: 600, contacts: 20 }, ... }

  // Dates
  datePublication        DateTime?
  dateExpiration         DateTime?
  dateDerniereModif      DateTime?
  derniereSynchro        DateTime?
  prochainRenouvellement DateTime?

  // Historique des remontées/boost
  historiqueBooosts Json? // [{ date: "...", duree: 7, cout: 5 }, ...]

  // Logs et erreurs
  erreurMessage String?
  logsSync      Json? // Historique des synchros

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  leads LeadPortail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bienId, portail])
  @@index([entrepriseId])
  @@index([portail])
  @@index([statut])
  @@index([dateExpiration])
}

// Leads générés par les portails (contacts entrants)
model LeadPortail {
  id String @id @default(cuid())

  // Source
  diffusion   DiffusionAnnonce @relation(fields: [diffusionId], references: [id])
  diffusionId String
  portail     PortailDiffusion

  // Contact
  nom       String
  prenom    String?
  email     String
  telephone String?
  message   String? @db.Text

  // Qualification
  budget        Decimal? @db.Decimal(12, 2)
  delaiAchat    String? // "Immédiat", "3 mois", "6 mois", "1 an"
  financementOk Boolean?
  dejaProprio   Boolean?

  // Statut du lead
  statut       String    @default("nouveau") // nouveau, contacte, qualifie, rdv, perdu
  dateContact  DateTime?
  agentAssigne Employee? @relation("LeadAgentResponsable", fields: [agentId], references: [id])
  agentId      String?

  // Converti en client ?
  clientConverti Client? @relation("LeadsConvertis", fields: [clientId], references: [id])
  clientId       String?

  dateReception DateTime @default(now())
  notes         String?  @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([diffusionId])
  @@index([statut])
  @@index([dateReception])
}

// Matching acquéreurs
model RechercheAcquereur {
  id String @id @default(cuid())

  // Acquéreur
  acquereur   Client @relation("RecherchesAcquereur", fields: [acquereurId], references: [id])
  acquereurId String

  // Critères de recherche
  typesBiens TypeBien[] // Types recherchés
  enAchat    Boolean    @default(true)
  enLocation Boolean    @default(false)

  // Budget
  budgetMin Decimal? @db.Decimal(12, 2)
  budgetMax Decimal? @db.Decimal(12, 2)
  loyerMax  Decimal? @db.Decimal(10, 2)

  // Localisation
  villesRecherchees String[] // Array de villes
  codesPostaux      String[]
  rayonKm           Int? // Rayon de recherche

  // Surface
  surfaceMin    Decimal? @db.Decimal(10, 2)
  surfaceMax    Decimal? @db.Decimal(10, 2)
  nbPiecesMin   Int?
  nbPiecesMax   Int?
  nbChambresMin Int?

  // Critères optionnels
  avecJardin             Boolean?
  avecParking            Boolean?
  avecAscenseur          Boolean?
  rdcUniquement          Boolean  @default(false)
  dernierEtageUniquement Boolean  @default(false)

  // DPE
  dpeMaximum String? // A, B, C, D, E

  // Statut
  actif   Boolean @default(true)
  urgence Int     @default(3) // 1=très urgent, 5=pas pressé

  notes String? @db.Text

  // Matching
  biensMatchs     Json? // IDs des biens correspondants (cache)
  dernierMatching DateTime?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([acquereurId])
  @@index([actif])
}
