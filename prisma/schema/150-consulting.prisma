// CONSULTING MODELS - Missions, Temps

model Mission {
  id          String  @id @default(cuid())
  numero      String // MISS-2024-001 or DOSS-2024-001
  nom         String // Mission title
  description String? @db.Text

  // Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Comptabilite specific (optional, for accounting firms)
  typeDossier    TypeDossierComptable? // Type of accounting file
  periodicite    PeriodiciteEcheance? // Recurrence for recurring tasks
  exerciceFiscal String? // Fiscal year (e.g., "2024" or "2024-2025")
  anneeReference Int? // Reference year for declarations

  // Billing configuration
  typeFact       TypeFacturation @default(REGIE)
  montantForfait Decimal?        @db.Decimal(10, 2) // Fixed price (if FORFAIT or MIXTE)
  tauxHoraire    Decimal?        @db.Decimal(10, 2) // Hourly rate (if REGIE or MIXTE)
  budgetHeures   Int? // Estimated hours in minutes

  // Scheduling
  dateDebut    DateTime? @db.Date
  dateFin      DateTime? @db.Date
  dateEcheance DateTime? @db.Date // Deadline

  // Status
  statut StatutMission @default(PROPOSITION)

  // Calculated totals (updated on time entry changes)
  totalHeures     Int     @default(0) // Total minutes tracked
  totalFacturable Int     @default(0) // Billable minutes
  totalMontant    Decimal @default(0) @db.Decimal(10, 2) // Total amount

  // Link to quote (if created from a quote)
  devisId String?
  devis   Document? @relation("MissionDevis", fields: [devisId], references: [id])

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Creator
  createdById String?

  // Relations
  entreesTemps EntreeTemps[]
  factures     Document[]        @relation("MissionFactures")
  echeances    EcheanceFiscale[] // Fiscal deadlines related to this mission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([clientId])
  @@index([statut])
  @@index([dateDebut])
  @@index([dateFin])
  @@index([entrepriseId, statut])
  @@index([entrepriseId, clientId])
  @@index([typeDossier])
}

// Time entry for consulting missions
model EntreeTemps {
  id String @id @default(cuid())

  // Mission
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // User who tracked time
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Time data
  date        DateTime @db.Date
  duree       Int // Duration in minutes
  description String   @db.Text

  // Billing
  facturable  Boolean @default(true)
  tauxHoraire Decimal @db.Decimal(10, 2) // Hourly rate applied
  montant     Decimal @db.Decimal(10, 2) // Calculated amount (duree/60 * tauxHoraire)

  // Invoice link (when invoiced)
  facturee  Boolean @default(false)
  factureId String? // Document ID when invoiced

  // Timer support
  timerStart DateTime? // Start time if using timer
  timerEnd   DateTime? // End time if using timer

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([missionId])
  @@index([userId])
  @@index([date])
  @@index([facturable])
  @@index([facturee])
  @@index([entrepriseId, date])
  @@index([entrepriseId, userId])
  @@index([missionId, facturee])
}
