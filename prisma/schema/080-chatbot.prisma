// CHATBOT & AI MODELS

model Conversation {
  id     String  @id @default(cuid())
  titre  String // Auto-généré à partir du premier message
  pinned Boolean @default(false) // Conversations épinglées

  // Multi-tenant
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([entrepriseId])
  @@index([createdAt])
  @@index([pinned])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  role    MessageRole // "user" | "assistant" | "system"
  content String      @db.Text

  // Tracking du modèle IA utilisé (pour analytics)
  model String? // "gpt-4o-mini" | "gpt-4o" | null (si user message)

  // Métadonnées JSON pour:
  // - Actions exécutées (function calling results)
  // - Feedback utilisateur (thumbs up/down)
  // - Tokens utilisés (input/output)
  // - Temps de réponse
  metadata Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
}

// Audit log pour le chatbot (traçabilité des actions)
model ChatbotAuditLog {
  id String @id @default(cuid())

  // Qui
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Quoi
  eventType   String // MESSAGE_SENT, ACTION_EXECUTED, INJECTION_DETECTED, etc.
  riskLevel   String // low, medium, high, critical
  description String @db.Text
  actionName  String? // Nom de l'action si applicable

  // Contexte
  conversationId String?
  messageId      String?

  // Résultat
  result       String? // success, failure, blocked
  errorMessage String? @db.Text

  // Métadonnées
  metadata  Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entrepriseId])
  @@index([eventType])
  @@index([riskLevel])
  @@index([createdAt])
}

// Tokens de confirmation pour actions critiques
model ChatbotActionToken {
  id String @id @default(cuid())

  // Token (hashé)
  tokenHash String @unique

  // Action à exécuter
  actionName   String
  actionParams String @db.Text // JSON des paramètres
  riskLevel    String // low, medium, high, critical

  // Qui
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Contexte
  conversationId String

  // État
  used   Boolean   @default(false)
  usedAt DateTime?

  // Expiration
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@index([entrepriseId])
  @@index([expiresAt])
  @@index([used])
}
