  ROBINETTERIE // Faucets
  SANITAIRES // Toilets, sinks
  TUYAUTERIE // Piping
  EVACUATION // Drainage
  ADOUCISSEUR // Water softener
  BALLON_EAU_CHAUDE // Hot water tank

  // === CHAUFFAGE ===
  CHAUDIERE_GAZ // Gas boiler
  CHAUDIERE_FIOUL // Oil boiler
  CHAUDIERE_BOIS // Wood boiler
  CHAUDIERE_ELECTRIQUE // Electric boiler
