model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  company String?
  phone   String?
  message String  @db.Text

  // Timestamps
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ============================================
// INTERVENTION BUSINESS MODULES (Plomberie, Chauffage, Électricité, etc.)
// ============================================

// Type d'intervention (tous métiers)
enum TypeIntervention {
  // === PLOMBERIE / CHAUFFAGE ===
  FUITE // Leak/emergency (plomberie)
  DEPANNAGE // Repair (tous)
  INSTALLATION // Installation (tous)
  ENTRETIEN // Maintenance (tous)
  DIAGNOSTIC // Diagnostic visit (tous)
  DEBOUCHAGE // Unclogging (plomberie)
  REMPLACEMENT // Replacement (tous)
  RENOVATION // Renovation work (tous)
  MISE_EN_SERVICE // Commissioning (chauffage, électricité)
  RAMONAGE // Chimney sweeping (chauffage)
  CONTROLE_ANNUEL // Annual inspection (chauffage - obligatoire)
  // === MENUISERIE ===
  POSE // Installation/fitting (menuiserie)
  FABRICATION // Manufacturing (menuiserie)
  REPARATION // Repair (menuiserie)
  AJUSTEMENT // Adjustment (menuiserie)
  FINITION // Finishing (menuiserie)
  RESTAURATION // Restoration (menuiserie)
  PRISE_COTES // Taking measurements (menuiserie)
  DEPOSE // Removal (menuiserie)
  // === PEINTURE ===
  PREPARATION_SURFACES // Surface preparation (peinture)
  PEINTURE_INTERIEURE // Interior painting (peinture)
  PEINTURE_EXTERIEURE // Exterior painting (peinture)
  RAVALEMENT // Facade renovation (peinture)
  ENDUIT // Rendering/plastering (peinture)
  PAPIER_PEINT // Wallpaper (peinture)
  LASURE_VERNIS // Stain/varnish (peinture)
  DECORATION // Decorative painting (peinture)
  TRAITEMENT_SURFACES // Surface treatment (peinture)
  // === GARAGE / AUTOMOBILE ===
  REVISION // Periodic maintenance
  VIDANGE // Oil change
  FREINAGE // Brake repair/service
  PNEUMATIQUES // Tire service
  EMBRAYAGE // Clutch replacement
  DISTRIBUTION // Timing belt service
  ECHAPPEMENT // Exhaust repair
  SUSPENSION // Suspension work
  DIRECTION // Steering repair
  DEMARRAGE // Starting system repair
  CARROSSERIE // Body repair
}

// Statut d'intervention
enum StatutIntervention {
  DEMANDE // Request received
  PLANIFIEE // Scheduled
  EN_ROUTE // Technician on the way
  SUR_PLACE // On site
  DIAGNOSTIC_FAIT // Diagnostic completed
  DEVIS_ENVOYE // Quote sent
  DEVIS_ACCEPTE // Quote accepted
  EN_COURS // Work in progress
  TERMINEE // Completed
  FACTUREE // Invoiced
  ANNULEE // Cancelled
}

// Priorité d'intervention
enum PrioriteIntervention {
  NORMALE // Normal
  URGENTE // Urgent (leak, no heating)
  CRITIQUE // Critical (flooding, gas leak, safety issue)
}

// Type d'équipement (tous métiers intervention)
