// Model Intervention (core business for plumbers)
model Intervention {
  id        String  @id @default(cuid())
  numero    String  @unique // INT-001, INT-002, etc.
  reference String? // Optional client reference

  // Client information
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  // Intervention type and priority
  typeIntervention TypeIntervention
  priorite         PrioriteIntervention @default(NORMALE)

  // Location (geocoding for route optimization)
  adresse           String
  codePostal        String
  ville             String
  complementAdresse String? // Apartment number, building, etc.
  latitude          Float?
  longitude         Float?

  // Issue description
  description      String          @db.Text // Customer complaint
  equipement       TypeEquipement?
  marqueEquipement String? // Equipment brand
  modeleEquipement String? // Equipment model
  anneeInstall     Int? // Installation year

  // Diagnostic
  diagnosticEffectue Boolean   @default(false)
  diagnosticDetail   String?   @db.Text
  diagnosticDate     DateTime?
  diagnosticParId    String? // User ID who performed diagnostic
  photosAvant        Json? // Array of photo URLs taken before work

  // Scheduling
  dateDemande        DateTime  @default(now())
  datePrevisionnelle DateTime? // Expected date/time
  dateDebut          DateTime? // Actual start
  dateFin            DateTime? // Actual completion
  dureeEstimeeH      Float? // Estimated duration in hours
  dureeReelleH       Float? // Actual duration in hours

  // Status and workflow
  statut           StatutIntervention @default(DEMANDE)
  statutChangeLogs Json? // History of status changes

  // Plumber assignment
  plombier   User?   @relation("InterventionPlombier", fields: [plombierId], references: [id])
  plombierId String?

  // Camionnette assignment (which vehicle/team)
  camionnette   Camionnette? @relation(fields: [camionnetteId], references: [id])
  camionnetteId String?

  // Costs and billing
  devisEstime     Decimal @default(0) @db.Decimal(10, 2) // Estimated cost
  coutMain        Decimal @default(0) @db.Decimal(10, 2) // Labor cost
  coutMateriel    Decimal @default(0) @db.Decimal(10, 2) // Materials cost (auto-calculated)
  coutTotal       Decimal @default(0) @db.Decimal(10, 2) // Total cost
  coutDeplacement Decimal @default(0) @db.Decimal(10, 2) // Travel cost

  // Linked document (quote or invoice)
  document   Document? @relation("InterventionDocument", fields: [documentId], references: [id])
  documentId String?

  // Contract link (if part of maintenance contract)
  contrat   ContratEntretien? @relation(fields: [contratId], references: [id])
  contratId String?

  // Internal notes
  notesInternes String? @db.Text
  notesPlombier String? @db.Text
  photosApres   Json? // Array of photo URLs taken after work

  // Payment on site
  payeSurPlace  Boolean        @default(false)
  moyenPaiement MoyenPaiement?
  datePaiement  DateTime?

  // Warranty
  garantieMois    Int? // Warranty period in months
  dateFinGarantie DateTime? // Warranty end date

  // Real-time notifications
  notificationsEnvoyees Json? // Track which notifications were sent to client

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  materielUtilise InterventionMateriel[] // Materials used
  timeLogs        InterventionTimeLog[] // Time tracking per plumber
  historique      InterventionHistorique[] // Complete history log

  createdBy String? // User ID who created the intervention
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([clientId])
  @@index([statut])
  @@index([plombierId])
  @@index([camionnetteId])
  @@index([dateDemande])
  @@index([datePrevisionnelle])
  @@index([entrepriseId, statut])
  @@index([entrepriseId, dateDemande])
  @@index([priorite])
  @@index([typeIntervention])
  @@index([ville])
  @@index([codePostal])
}

// Materials used in intervention
model InterventionMateriel {
  id String @id @default(cuid())

  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  interventionId String

  // Link to article or camionnette stock
  article   Article? @relation(fields: [articleId], references: [id])
  articleId String?

  stockCamionnette   StockCamionnette? @relation(fields: [stockCamionnetteId], references: [id])
  stockCamionnetteId String?

  designation  String
  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)
  montant      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([interventionId])
  @@index([articleId])
  @@index([stockCamionnetteId])
}

// Time tracking for plumbers during interventions
model InterventionTimeLog {
  id String @id @default(cuid())

  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  interventionId String

  plombier   User   @relation("InterventionPlombierTime", fields: [plombierId], references: [id])
  plombierId String

  dateDebut    DateTime
  dateFin      DateTime?
  dureeMinutes Int? // Auto-calculated duration

  description String @db.Text
  type        String @default("TRAVAUX") // DEPLACEMENT, DIAGNOSTIC, TRAVAUX, TEST

  // Location tracking (optional)
  latitudeDebut  Float?
  longitudeDebut Float?
  latitudeFin    Float?
  longitudeFin   Float?

  createdAt DateTime @default(now())

  @@index([interventionId])
  @@index([plombierId])
  @@index([dateDebut])
}

// Complete history log for interventions
model InterventionHistorique {
  id String @id @default(cuid())

  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  interventionId String

  action      String // "STATUS_CHANGE", "MATERIEL_ADDED", "NOTE_ADDED", "ASSIGNED", etc.
  description String @db.Text
  metadata    Json? // Additional data (old/new values)

  createdBy String? // User ID
  createdAt DateTime @default(now())

  @@index([interventionId])
  @@index([createdAt])
  @@index([action])
}

// Camionnette (van/vehicle for mobile stock)
model Camionnette {
  id              String  @id @default(cuid())
  nom             String? // Name (optional, generated from immatriculation if not provided)
  immatriculation String  @unique
  marque          String? // Brand (Renault, Peugeot, etc.)
  modele          String? // Model
  annee           Int? // Year

  // Assignment
  plombierPrincipal   User?   @relation(fields: [plombierPrincipalId], references: [id])
  plombierPrincipalId String?

  // Status
  actif Boolean @default(true)

  // Tracking
  dernierePosition  Json? // { latitude, longitude, timestamp }
  dernierEntretien  DateTime?
  prochainEntretien DateTime?
  kilometres        Int       @default(0)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  stock         StockCamionnette[]
  interventions Intervention[]
  entretiens    EntretienVehicule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, immatriculation])
  @@index([entrepriseId])
  @@index([plombierPrincipalId])
  @@index([actif])
}

// Entretien de véhicule
model EntretienVehicule {
  id String @id @default(cuid())

  // Véhicule concerné
  camionnette   Camionnette @relation(fields: [camionnetteId], references: [id], onDelete: Cascade)
  camionnetteId String

  // Type d'entretien
  type TypeEntretienVehicule

  // Détails
  description String?  @db.Text
  kilometrage Int? // Kilométrage au moment de l'entretien
  cout        Decimal? @db.Decimal(10, 2)

  // Dates
  dateEntretien DateTime
  dateProchain  DateTime? // Prochaine date d'entretien recommandée

  // Prestataire
  prestataire   String? // Nom du garage/prestataire
  numeroFacture String?

  // Notes
  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([camionnetteId])
  @@index([entrepriseId])
  @@index([dateEntretien])
  @@index([type])
}

enum TypeEntretienVehicule {
  VIDANGE
  REVISION
  PNEUS
  FREINS
  CONTROLE_TECHNIQUE
  REPARATION
  AUTRE
}

// Stock mobile in each van
model StockCamionnette {
  id String @id @default(cuid())

  camionnette   Camionnette @relation(fields: [camionnetteId], references: [id], onDelete: Cascade)
  camionnetteId String

  // Material info (could link to Article or be standalone)
  article   Article? @relation(fields: [articleId], references: [id])
  articleId String?

  designation String
  reference   String?
  categorie   String? // VANNE, TUYAU, JOINT, RACCORD, etc.

  // Stock levels
  quantite     Int
  seuilAlerte  Int     @default(2) // Alert when below this quantity
  prixUnitaire Decimal @db.Decimal(10, 2)

  // Specifications (for plumbing parts)
  diametre String? // Diameter (12mm, 15/21, etc.)
  materiau String? // Material (cuivre, PER, PVC, laiton)
  longueur Float? // Length if applicable (meters)

  // Multi-tenant (inherited from camionnette, but useful for queries)
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  mouvements            MouvementStockCamionnette[]
  interventionsMateriel InterventionMateriel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([camionnetteId])
  @@index([articleId])
  @@index([entrepriseId])
  @@index([quantite]) // For low stock alerts
  @@index([categorie])
}

// Stock movements for van inventory
enum TypeMouvementCamionnette {
  CHARGEMENT // Loading from depot
  UTILISATION // Used in intervention
  RETOUR_DEPOT // Return to depot
  AJUSTEMENT // Adjustment/correction
  TRANSFERT // Transfer between vans
  PERTE // Lost/damaged
}

model MouvementStockCamionnette {
  id String @id @default(cuid())

  stockCamionnette   StockCamionnette @relation(fields: [stockCamionnetteId], references: [id], onDelete: Cascade)
  stockCamionnetteId String

  type       TypeMouvementCamionnette
  quantite   Int
  stockAvant Int
  stockApres Int
  motif      String?
  reference  String? // Intervention number if used in intervention

  // User who performed the movement
  createdBy String? // User ID
  createdAt DateTime @default(now())

  @@index([stockCamionnetteId])
  @@index([type])
  @@index([createdAt])
}

// Maintenance contracts (recurring revenue)
enum TypeContratEntretien {
  // Chauffage
  CHAUDIERE_GAZ // Gas boiler maintenance
  CHAUDIERE_FIOUL // Oil boiler maintenance
  POMPE_A_CHALEUR // Heat pump maintenance
  CLIMATISATION // AC maintenance
  PLANCHER_CHAUFFANT // Underfloor heating maintenance
  // Plomberie
  ADOUCISSEUR // Water softener maintenance
  PLOMBERIE_GENERAL // General plumbing (X interventions/year)
  // Commun
  MULTI_EQUIPEMENTS // Multiple equipment package
  PERSONNALISE // Custom contract
}

enum StatutContrat {
  ACTIF // Active
  EXPIRE // Expired
  RESILIE // Terminated
  EN_ATTENTE // Pending (not yet started)
  SUSPENDU // Suspended
}

enum PeriodiciteContrat {
  MENSUEL // Monthly
  TRIMESTRIEL // Quarterly
  SEMESTRIEL // Semi-annual
  ANNUEL // Annual
}

model ContratEntretien {
  id        String  @id @default(cuid())
  numero    String  @unique // CONT-001, CONT-002, etc.
  reference String? // Optional client reference

  // Client
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  // Contract details
  typeContrat TypeContratEntretien
  nom         String // Contract name
  description String?              @db.Text

  // Equipment covered
  equipements Json // Array of equipment with details
  adresse     String
  codePostal  String
  ville       String

  // Contract terms
  dateDebut   DateTime
  dateFin     DateTime
  dureeAnnees Int           @default(1)
  statut      StatutContrat @default(ACTIF)

  // Pricing
  montantHT        Decimal            @db.Decimal(10, 2)
  montantTTC       Decimal            @db.Decimal(10, 2)
  periodicite      PeriodiciteContrat @default(ANNUEL)
  prochainPaiement DateTime?

  // Recurring billing
  facturationAuto Boolean @default(false)
  jourFacturation Int? // Day of month for billing

  // Included services
  nombreRevisionsAn      Int      @default(1) // Number of annual reviews
  interventionsIncluses  Int      @default(0) // Included interventions per year
  interventionsUtilisees Int      @default(0) // Used interventions
  tarifHoraire           Decimal? @db.Decimal(10, 2) // Hourly rate for extra work
  remisePieces           Decimal  @default(0) @db.Decimal(5, 2) // Discount on parts

  // Notifications and reminders
  rappelAvantJours  Int       @default(30) // Remind client X days before
  derniereRevision  DateTime?
  prochaineRevision DateTime?

  // Notes
  notes                String? @db.Text
  clausesParticulieres String? @db.Text

  // Renewal
  renouvellementAuto Boolean   @default(true)
  dateResiliation    DateTime?
  motifResiliation   String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  interventions     Intervention[] // Linked interventions
  entretiensEnCours EntretienPrevu[] // Scheduled maintenances

  createdBy String? // User ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([clientId])
  @@index([statut])
  @@index([dateDebut])
  @@index([dateFin])
  @@index([prochaineRevision])
  @@index([entrepriseId, statut])
}

// Scheduled maintenance from contracts
enum StatutEntretien {
  PLANIFIE // Scheduled
  CONFIRME // Confirmed by client
  EN_COURS // In progress
  TERMINE // Completed
  REPORTE // Postponed
  ANNULE // Cancelled
}

model EntretienPrevu {
  id String @id @default(cuid())

  contrat   ContratEntretien @relation(fields: [contratId], references: [id], onDelete: Cascade)
  contratId String

  // Scheduling
  datePrevue    DateTime
  dateEffectuee DateTime?
  statut        StatutEntretien @default(PLANIFIE)

  // Assignment
  plombier   User?   @relation(fields: [plombierId], references: [id])
  plombierId String?

  // Equipments to check
  equipements Json // Which equipment to service

  // Results
  compteRendu        String? @db.Text
  anomaliesDetectees String? @db.Text
  recommandations    String? @db.Text
  photos             Json? // Array of photo URLs

  // Next maintenance
  prochaineDate DateTime?

  // Notifications
  rappelEnvoye       Boolean   @default(false)
  dateRappel         DateTime?
  confirmationClient Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contratId])
  @@index([datePrevue])
  @@index([statut])
  @@index([plombierId])
}

// ============================================
// PARC ÉQUIPEMENTS CLIENTS (Chauffage/Plomberie)
// ============================================

// Type d'énergie pour les équipements de chauffage
enum TypeEnergie {
  GAZ_NATUREL
  GAZ_PROPANE
  FIOUL
  ELECTRICITE
  BOIS_BUCHES
  BOIS_GRANULES
  POMPE_CHALEUR
  SOLAIRE
  GEOTHERMIE
}

// Statut de l'équipement
enum StatutEquipement {
  EN_SERVICE // Operational
  EN_PANNE // Broken down
  A_REMPLACER // Needs replacement
  HORS_SERVICE // Out of service
  EN_ATTENTE_PIECE // Waiting for parts
}

// Équipement installé chez un client
model EquipementClient {
  id String @id @default(cuid())

  // Client owner
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  // Equipment identification
  type        TypeEquipement
  marque      String
  modele      String?
  numeroSerie String?
  puissanceKw Decimal?       @db.Decimal(10, 2) // Power in kW
  typeEnergie TypeEnergie?

  // Installation details
  dateInstallation  DateTime?
  dateMiseEnService DateTime?
  installePar       String? // Company name or "Nous"
  garantieJusquau   DateTime?

  // Location at client's premises
  emplacement   String? // "Garage", "Sous-sol", "Combles"...
  adresse       String? // If different from client address
  codePostal    String?
  ville         String?
  accessibilite String? // Access notes for technician

  // Current status
  statut            StatutEquipement @default(EN_SERVICE)
  dernierEntretien  DateTime?
  prochainEntretien DateTime? // Next scheduled maintenance

  // Regulatory compliance (for boilers, etc.)
  controleObligatoire     Boolean   @default(false)
  frequenceControleAnnuel Int       @default(1) // Number of mandatory checks per year
  dernierControleAnnuel   DateTime?
  prochainControleAnnuel  DateTime?
  certificatValide        Boolean   @default(false)

  // Performance tracking
  rendementPourcent Decimal?  @db.Decimal(5, 2) // Efficiency %
  emissionsCO       Decimal?  @db.Decimal(10, 2) // CO emissions (ppm)
  dateReleve        DateTime?

  // Notes
  notes         String? @db.Text
  documentsUrls Json? // Array of document URLs (manuals, certificates)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  certificats             CertificatEntretien[]
  historiqueInterventions Json? // Snapshot of intervention IDs for this equipment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([clientId])
  @@index([type])
  @@index([statut])
  @@index([prochainEntretien])
  @@index([prochainControleAnnuel])
  @@index([entrepriseId, prochainControleAnnuel])
  @@index([entrepriseId, statut])
}

// Certificat d'entretien (obligatoire pour chaudières gaz/fioul)
model CertificatEntretien {
  id String @id @default(cuid())

  // Equipment
  equipement   EquipementClient @relation(fields: [equipementId], references: [id], onDelete: Cascade)
  equipementId String

  // Certificate details
  numero           String   @unique
  dateIntervention DateTime
  dateValidite     DateTime // Usually 1 year after intervention

  // Technician
  technicien    User?   @relation(fields: [technicienId], references: [id])
  technicienId  String?
  nomTechnicien String // Stored for PDF even if user deleted

  // Equipment state at time of maintenance
  typeEquipement    String
  marque            String
  modele            String?
  numeroSerie       String?
  puissanceKw       Decimal? @db.Decimal(10, 2)
  typeEnergie       String?
  anneeInstallation Int?

  // Measurements & checks (for official certificate)
  temperatureFumees   Decimal? @db.Decimal(5, 1) // °C
  temperatureAmbiante Decimal? @db.Decimal(5, 1) // °C
  tauxCO              Decimal? @db.Decimal(10, 2) // ppm
  tauxCO2             Decimal? @db.Decimal(5, 2) // %
  rendementCombustion Decimal? @db.Decimal(5, 2) // %
  tirage              Decimal? @db.Decimal(5, 2) // Pa
  pressionGaz         Decimal? @db.Decimal(5, 2) // mbar
  debitGaz            Decimal? @db.Decimal(10, 2) // m³/h

  // Checklist items
  verificationBruleur     Boolean @default(false)
  verificationVeilleuse   Boolean @default(false)
  nettoyageCorpChauffe    Boolean @default(false)
  verificationEtancheite  Boolean @default(false)
  verificationEvacuation  Boolean @default(false)
  verificationVentilation Boolean @default(false)
  verificationSecurites   Boolean @default(false)
  verificationRegulation  Boolean @default(false)
  nettoyageConduitFumee   Boolean @default(false)
  controleCircuitEau      Boolean @default(false)
  controleVaseExpansion   Boolean @default(false)
  controleCirculateur     Boolean @default(false)
  purgeRadiateurs         Boolean @default(false)

  // Observations & recommendations
  anomaliesConstatees   String? @db.Text
  recommandations       String? @db.Text
  travauxPreconises     String? @db.Text
  observationsGenerales String? @db.Text

  // Compliance
  conformeReglementation Boolean @default(true)
  motifNonConformite     String? @db.Text
  dangerImmediat         Boolean @default(false)

  // Client signature
  signatureClient String? // Base64 or URL
  dateSignature   DateTime?
  nomSignataire   String?

  // PDF
  pdfUrl          String?
  envoiClient     Boolean   @default(false)
  dateEnvoiClient DateTime?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([equipementId])
  @@index([dateIntervention])
  @@index([dateValidite])
  @@index([technicienId])
  @@index([entrepriseId, dateValidite])
}

// ============================================
// RESTAURATION - Tables & Réservations
// ============================================

enum TableStatut {
  LIBRE
  OCCUPEE
  RESERVEE
}

enum ReservationStatut {
  EN_ATTENTE
  CONFIRMEE
  ARRIVEE // Client arrivé
  TERMINEE // Service terminé
  ANNULEE
  NO_SHOW // Client pas venu
}

model TableRestaurant {
  id       String      @id @default(cuid())
  numero   Int
  nom      String? // "Table 1", "Terrasse 3", etc.
  capacite Int         @default(4)
  zone     String      @default("Salle principale")
  statut   TableStatut @default(LIBRE)

  // Relations
  entrepriseId String
  entreprise   Entreprise    @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([statut])
  @@index([zone])
  @@index([entrepriseId, statut])
}

model Reservation {
  id String @id @default(cuid())

  // Client (peut être un client existant ou juste un nom)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id])
  nomClient String // Nom si pas de client lié
  telephone String?
  email     String?

  // Détails réservation
  date      DateTime
  heure     String // "19:30"
  personnes Int
  statut    ReservationStatut @default(EN_ATTENTE)
  notes     String?

  // Table assignée (optionnel à la création)
  tableId String?
  table   TableRestaurant? @relation(fields: [tableId], references: [id])

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([date])
  @@index([statut])
  @@index([clientId])
  @@index([tableId])
  @@index([entrepriseId, date])
  @@index([entrepriseId, statut])
}

model MenuItem {
  id               String  @id @default(cuid())
  nom              String
  description      String?
  prix             Decimal @db.Decimal(10, 2)
  categorie        String  @default("Plats") // Entrées, Plats, Desserts, Boissons, Formules, etc.
  allergenes       Json?   @default("[]") // Array of allergens
  tempsPreparation Int? // Temps en minutes
  disponible       Boolean @default(true)
  imageUrl         String?
  ordre            Int     @default(0) // Pour trier dans la catégorie

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([categorie])
  @@index([disponible])
  @@index([entrepriseId, categorie])
  @@index([entrepriseId, disponible])
}

// ============================================
// COIFFURE / RENDEZ-VOUS MODELS
// ============================================

enum RendezVousStatut {
  EN_ATTENTE
  CONFIRME
  EN_COURS
  TERMINE
  ANNULE
  NO_SHOW
}

model Prestation {
  id          String  @id @default(cuid())
  nom         String
  description String?
  duree       Int // Durée en minutes
  prix        Decimal @db.Decimal(10, 2)
  categorie   String? // Coupe, Couleur, Soin, etc.
  actif       Boolean @default(true)
  ordre       Int     @default(0)

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  rendezVous RendezVous[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([categorie])
  @@index([actif])
  @@index([entrepriseId, actif])
}

model Employe {
  id        String  @id @default(cuid())
  nom       String
  prenom    String
  email     String?
  telephone String?
  couleur   String? // Pour le calendrier (code hex)
  actif     Boolean @default(true)

  // Spécialités coach (fitness) - JSON array de strings
  // Ex: ["musculation", "cardio", "yoga", "pilates", "boxe", "crossfit"]
  specialites    Json? // Spécialités du coach (fitness)
  bio            String? // Biographie/description du coach
  certifications String? // Certifications (BPJEPS, etc.)

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  disponibilites DisponibiliteEmploye[]
  rendezVous     RendezVous[]

  // Relations fitness (coach)
  coursAnimes    CoursCollectif[] // Cours dont il est l'instructeur par défaut
  seancesAnimees SeanceCours[] // Séances qu'il anime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([actif])
  @@index([entrepriseId, actif])
}

model DisponibiliteEmploye {
  id          String  @id @default(cuid())
  jourSemaine Int // 0=Dim, 1=Lun, 2=Mar, 3=Mer, 4=Jeu, 5=Ven, 6=Sam
  heureDebut  String // "09:00"
  heureFin    String // "18:00"
  pause       Boolean @default(false) // true = indisponibilité (pause déjeuner)

  // Relations
  employeId String
  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeId])
  @@index([jourSemaine])
  @@index([employeId, jourSemaine])
}

model RendezVous {
  id String @id @default(cuid())

  // Client (optionnel si client existant)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  nomClient String // Nom si pas de client existant
  telephone String?
  email     String?

  // Rendez-vous
  date   DateTime
  heure  String // "14:30"
  duree  Int // Durée en minutes
  statut RendezVousStatut @default(EN_ATTENTE)
  notes  String?

  // Prestation et employé
  prestationId String?
  prestation   Prestation? @relation(fields: [prestationId], references: [id], onDelete: SetNull)
  employeId    String?
  employe      Employe?    @relation(fields: [employeId], references: [id], onDelete: SetNull)

  // Cabine (optionnel - pour esthétique/spa)
  cabineId String?
  cabine   Cabine? @relation(fields: [cabineId], references: [id], onDelete: SetNull)

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([date])
  @@index([statut])
  @@index([clientId])
  @@index([employeId])
  @@index([prestationId])
  @@index([cabineId])
  @@index([entrepriseId, date])
  @@index([entrepriseId, statut])
  @@index([employeId, date])
}

// ============================================
// CABINES / SALLES DE SOINS (ESTHETIQUE)
// ============================================

model Cabine {
  id          String  @id @default(cuid())
  nom         String // "Cabine 1", "Salle Zen", "Cabine Hammam"
  description String?
  type        String? // "massage", "epilation", "soin_visage", "uv", "hammam"
  capacite    Int     @default(1) // Nombre de personnes max
  equipements String? // Liste des équipements (table, jacuzzi, UV, etc.)
  couleur     String? // Pour l'affichage dans le planning
  actif       Boolean @default(true)
  ordre       Int     @default(0)

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  rendezVous RendezVous[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([actif])
  @@index([type])
  @@index([entrepriseId, actif])
}

// ============================================
// FITNESS / SALLE DE SPORT
// ============================================

// Statuts d'abonnement fitness
enum StatutAbonnementFitness {
  ACTIF // Abonnement en cours
  SUSPENDU // Temporairement suspendu (vacances, blessure)
  EXPIRE // Abonnement expiré
  RESILIE // Résilié par le client ou l'admin
  EN_ATTENTE // En attente de paiement/validation
}

// Périodicité de facturation
enum PeriodiciteFitness {
  JOURNALIER // Pass journée
  HEBDOMADAIRE
  MENSUEL
  TRIMESTRIEL
  SEMESTRIEL
  ANNUEL
  ILLIMITE // Abonnement à vie
}

// Niveau des cours
enum NiveauCours {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  TOUS_NIVEAUX
}

// Statut des séances de cours
enum StatutSeanceCours {
  PLANIFIEE // Séance programmée
  EN_COURS // Séance en cours
  TERMINEE // Séance terminée
  ANNULEE // Séance annulée
  COMPLETE // Plus de places disponibles
}

// Statut des réservations de cours
enum StatutReservationCours {
  CONFIRMEE // Réservation confirmée
  EN_ATTENTE // Liste d'attente
  ANNULEE // Annulée par le client
  NO_SHOW // Client absent
  PRESENTE // Client présent (check-in effectué)
}

// Type de salle/zone
enum TypeSalleFitness {
  MUSCULATION // Salle de musculation
  CARDIO // Espace cardio
  COURS_COLLECTIF // Salle de cours collectifs
  PISCINE // Piscine
  SAUNA // Sauna/hammam
  VESTIAIRE // Vestiaires
  CROSSFIT // Box CrossFit
  YOGA // Studio yoga/pilates
  SPINNING // Salle de cycling
  BOXE // Ring/salle de boxe
  AUTRE
}

// Type d'accès (check-in)
enum TypeAccesFitness {
  ENTREE // Entrée standard
  SORTIE // Sortie
  COURS // Accès pour un cours
  ESPACE_PREMIUM // Accès zone premium (spa, etc.)
}

// Types d'abonnements proposés par la salle
model TypeAbonnementFitness {
  id          String  @id @default(cuid())
  nom         String // "Mensuel", "Annuel", "Pass 10 séances"
  description String?

  // Tarification
  prix        Decimal            @db.Decimal(10, 2)
  periodicite PeriodiciteFitness @default(MENSUEL)

  // Durée
  dureeJours    Int? // Durée en jours (null si illimité ou pass séances)
  nombreSeances Int? // Pour les pass (10 séances, 20 séances, etc.)

  // Accès
  accesIllimite      Boolean @default(true) // Accès illimité ou limité
  nombreAccesSemaine Int? // Si limité: nombre d'accès par semaine
  accesCours         Boolean @default(true) // Accès aux cours collectifs
  accesZonesPremium  Boolean @default(false) // Accès sauna, spa, etc.

  // Options
  engagementMois   Int     @default(0) // Durée d'engagement en mois
  fraisInscription Decimal @default(0) @db.Decimal(10, 2)

  // Statut
  actif   Boolean @default(true)
  ordre   Int     @default(0)
  couleur String? // Pour l'affichage

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  abonnements AbonnementFitness[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([actif])
  @@index([periodicite])
  @@index([entrepriseId, actif])
}

// Abonnements des clients
model AbonnementFitness {
  id     String @id @default(cuid())
  numero String // Numéro unique d'abonnement

  // Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Type d'abonnement
  typeAbonnementId String
  typeAbonnement   TypeAbonnementFitness @relation(fields: [typeAbonnementId], references: [id])

  // Dates
  dateDebut       DateTime
  dateFin         DateTime? // Null si illimité
  dateResiliation DateTime? // Si résilié

  // Statut
  statut StatutAbonnementFitness @default(EN_ATTENTE)

  // Compteurs (pour les pass séances)
  seancesRestantes Int? // Nombre de séances restantes
  seancesUtilisees Int  @default(0)

  // Paiement
  montantPaye      Decimal   @default(0) @db.Decimal(10, 2)
  prochainPaiement DateTime?
  modePaiement     String? // "cb", "prelevement", "especes", "cheque"

  // Badge/Carte membre
  numeroCarte String? @unique // Numéro de carte/badge
  codeAcces   String? // Code PIN pour le check-in

  notes String?

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  presences PresenceFitness[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([clientId])
  @@index([typeAbonnementId])
  @@index([statut])
  @@index([dateDebut])
  @@index([dateFin])
  @@index([numeroCarte])
  @@index([entrepriseId, statut])
  @@index([entrepriseId, clientId])
}

// Cours collectifs proposés
model CoursCollectif {
  id          String  @id @default(cuid())
  nom         String // "Yoga Vinyasa", "Spinning Intense", "Body Pump"
  description String?

  // Caractéristiques
  dureeMinutes Int         @default(60)
  niveau       NiveauCours @default(TOUS_NIVEAUX)
  capaciteMax  Int         @default(20)

  // Catégorie
  categorie String? // "cardio", "renforcement", "bien-etre", "danse", "aquatique"

  // Coach par défaut
  instructeurId String?
  instructeur   Employe? @relation(fields: [instructeurId], references: [id], onDelete: SetNull)

  // Salle par défaut
  salleId String?
  salle   SalleFitness? @relation(fields: [salleId], references: [id], onDelete: SetNull)

  // Options
  materielNecessaire String? // "Tapis, serviette, bouteille d'eau"
  couleur            String? // Pour le planning
  actif              Boolean @default(true)
  reservationRequise Boolean @default(true) // Nécessite une réservation

  // Image
  imageUrl String?

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  seances SeanceCours[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([actif])
  @@index([niveau])
  @@index([categorie])
  @@index([instructeurId])
  @@index([salleId])
  @@index([entrepriseId, actif])
}

// Séances de cours planifiées
model SeanceCours {
  id String @id @default(cuid())

  // Cours
  coursId String
  cours   CoursCollectif @relation(fields: [coursId], references: [id], onDelete: Cascade)

  // Planning
  dateHeure    DateTime // Date et heure de début
  dureeMinutes Int? // Override de la durée du cours

  // Coach (peut être différent du coach par défaut)
  instructeurId String?
  instructeur   Employe? @relation(fields: [instructeurId], references: [id], onDelete: SetNull)

  // Salle (peut être différente de la salle par défaut)
  salleId String?
  salle   SalleFitness? @relation(fields: [salleId], references: [id], onDelete: SetNull)

  // Capacité (peut être override)
  capaciteMax Int? // Override de la capacité du cours

  // Statut
  statut StatutSeanceCours @default(PLANIFIEE)

  // Compteurs
  placesReservees Int @default(0)

  // Notes
  notes           String?
  motifAnnulation String? // Si annulée

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  reservations ReservationCours[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([coursId])
  @@index([dateHeure])
  @@index([statut])
  @@index([instructeurId])
  @@index([salleId])
  @@index([entrepriseId, dateHeure])
  @@index([entrepriseId, statut])
}

// Réservations aux cours
model ReservationCours {
  id String @id @default(cuid())

  // Séance
  seanceId String
  seance   SeanceCours @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  // Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Statut
  statut          StatutReservationCours @default(CONFIRMEE)
  positionAttente Int? // Position dans la liste d'attente

  // Check-in
  heureArrivee DateTime? // Heure d'arrivée effective

  // Notes
  notes String?

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seanceId, clientId]) // Un client ne peut réserver qu'une fois par séance
  @@index([entrepriseId])
  @@index([seanceId])
  @@index([clientId])
  @@index([statut])
  @@index([entrepriseId, clientId])
  @@index([seanceId, statut])
}

// Salles et zones de la salle de sport
model SalleFitness {
  id          String  @id @default(cuid())
  nom         String // "Salle Musculation", "Studio 1", "Piscine"
  description String?

  // Type
  type TypeSalleFitness @default(AUTRE)

  // Capacité
  capacite Int @default(0) // 0 = illimitée

  // Équipements
  equipements String? // Liste des équipements
  surface     Int? // Surface en m²

  // Options
  reservable Boolean @default(false) // Peut être réservée
  premium    Boolean @default(false) // Zone premium (accès restreint)
  actif      Boolean @default(true)
  ordre      Int     @default(0)
  couleur    String? // Pour l'affichage

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  cours     CoursCollectif[] // Cours qui s'y déroulent par défaut
  seances   SeanceCours[] // Séances qui s'y déroulent
  presences PresenceFitness[] // Check-ins dans cette zone

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([type])
  @@index([actif])
  @@index([premium])
  @@index([entrepriseId, actif])
}

// Check-ins / Présences
model PresenceFitness {
  id String @id @default(cuid())

  // Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Abonnement utilisé
  abonnementId String?
  abonnement   AbonnementFitness? @relation(fields: [abonnementId], references: [id], onDelete: SetNull)

  // Type d'accès
  typeAcces TypeAccesFitness @default(ENTREE)

  // Horaires
  heureEntree DateTime  @default(now())
  heureSortie DateTime?

  // Salle/Zone (optionnel)
  salleId String?
  salle   SalleFitness? @relation(fields: [salleId], references: [id], onDelete: SetNull)

  // Méthode de check-in
  methodCheckin String? // "badge", "code", "manuel", "app"

  // Notes
  notes String?

  // Tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([clientId])
  @@index([abonnementId])
  @@index([heureEntree])
  @@index([typeAcces])
  @@index([salleId])
  @@index([entrepriseId, heureEntree])
  @@index([entrepriseId, clientId])
}

// ============================================
// SERVICE INTELLECTUEL - CONSULTING
// ============================================

enum TypeFacturation {
  FORFAIT // Fixed price for the mission
  REGIE // Time & materials (hourly billing)
  MIXTE // Fixed price + hourly overruns
}

enum StatutMission {
  PROPOSITION // Quote sent, waiting for approval
  VALIDEE // Approved, not started yet
  EN_COURS // Work in progress
  LIVREE // Delivered, pending invoicing
  FACTUREE // Invoiced
  CLOTUREE // Closed/archived
  ANNULEE // Cancelled
}

// ============================================
// SERVICE INTELLECTUEL - COMPTABILITE
// ============================================

// Type de dossier comptable
enum TypeDossierComptable {
  BILAN // Bilan annuel
  LIASSE_FISCALE // Liasse fiscale
  TVA // Déclaration TVA
  IS // Impôt sur les sociétés
  IR // Impôt sur le revenu
  PAIE // Gestion de la paie
  SOCIAL // Déclarations sociales (URSSAF, etc.)
  COMPTABILITE // Tenue comptable courante
  CONSEIL // Mission de conseil
  AUDIT // Audit/révision des comptes
  JURIDIQUE // Missions juridiques (AG, statuts, etc.)
  AUTRE // Autre type de mission
}

// Périodicité des échéances
enum PeriodiciteEcheance {
  PONCTUEL // Une seule fois
  MENSUEL // Chaque mois
  TRIMESTRIEL // Chaque trimestre
  SEMESTRIEL // Chaque semestre
  ANNUEL // Chaque année
}

// Statut d'une échéance fiscale
enum StatutEcheance {
  A_VENIR // Échéance à venir
  EN_COURS // Travail en cours
  PRET // Prêt pour dépôt
  DEPOSE // Déposé/transmis
  VALIDE // Validé par l'administration
  EN_RETARD // En retard
}

// Régime fiscal de l'entreprise cliente
enum RegimeFiscal {
  REEL_NORMAL // Réel normal
  REEL_SIMPLIFIE // Réel simplifié
  MICRO // Micro-entreprise / Auto-entrepreneur
}

// Régime de TVA
enum RegimeTVA {
  MENSUEL // Déclaration mensuelle (CA3)
  TRIMESTRIEL // Déclaration trimestrielle
  ANNUEL // Déclaration annuelle (CA12)
  FRANCHISE // Franchise en base de TVA
}

// Forme juridique de l'entreprise cliente
enum FormeJuridique {
  SARL // Société à responsabilité limitée
  SAS // Société par actions simplifiée
  SA // Société anonyme
  EURL // Entreprise unipersonnelle à responsabilité limitée
  SASU // Société par actions simplifiée unipersonnelle
  EI // Entreprise individuelle
  EIRL // Entreprise individuelle à responsabilité limitée
  SCI // Société civile immobilière
  SNC // Société en nom collectif
  ASSOCIATION // Association loi 1901
  AUTRE // Autre forme juridique
}

// Type d'imposition
enum TypeImposition {
  IS // Impôt sur les sociétés
  IR // Impôt sur le revenu
}

// Mission (project for consultants / dossier for accountants)
model Mission {
  id          String  @id @default(cuid())
  numero      String // MISS-2024-001 or DOSS-2024-001
  nom         String // Mission title
  description String? @db.Text

  // Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Comptabilite specific (optional, for accounting firms)
  typeDossier    TypeDossierComptable? // Type of accounting file
  periodicite    PeriodiciteEcheance? // Recurrence for recurring tasks
  exerciceFiscal String? // Fiscal year (e.g., "2024" or "2024-2025")
  anneeReference Int? // Reference year for declarations

  // Billing configuration
  typeFact       TypeFacturation @default(REGIE)
  montantForfait Decimal?        @db.Decimal(10, 2) // Fixed price (if FORFAIT or MIXTE)
  tauxHoraire    Decimal?        @db.Decimal(10, 2) // Hourly rate (if REGIE or MIXTE)
  budgetHeures   Int? // Estimated hours in minutes

  // Scheduling
  dateDebut    DateTime? @db.Date
  dateFin      DateTime? @db.Date
  dateEcheance DateTime? @db.Date // Deadline

  // Status
  statut StatutMission @default(PROPOSITION)

  // Calculated totals (updated on time entry changes)
  totalHeures     Int     @default(0) // Total minutes tracked
  totalFacturable Int     @default(0) // Billable minutes
  totalMontant    Decimal @default(0) @db.Decimal(10, 2) // Total amount

  // Link to quote (if created from a quote)
  devisId String?
  devis   Document? @relation("MissionDevis", fields: [devisId], references: [id])

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Creator
  createdById String?

  // Relations
  entreesTemps EntreeTemps[]
  factures     Document[]        @relation("MissionFactures")
  echeances    EcheanceFiscale[] // Fiscal deadlines related to this mission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([clientId])
  @@index([statut])
  @@index([dateDebut])
  @@index([dateFin])
  @@index([entrepriseId, statut])
  @@index([entrepriseId, clientId])
  @@index([typeDossier])
}

// Time entry for consulting missions
model EntreeTemps {
  id String @id @default(cuid())

  // Mission
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // User who tracked time
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Time data
  date        DateTime @db.Date
  duree       Int // Duration in minutes
  description String   @db.Text

  // Billing
  facturable  Boolean @default(true)
  tauxHoraire Decimal @db.Decimal(10, 2) // Hourly rate applied
  montant     Decimal @db.Decimal(10, 2) // Calculated amount (duree/60 * tauxHoraire)

  // Invoice link (when invoiced)
  facturee  Boolean @default(false)
  factureId String? // Document ID when invoiced

  // Timer support
  timerStart DateTime? // Start time if using timer
  timerEnd   DateTime? // End time if using timer

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([missionId])
  @@index([userId])
  @@index([date])
  @@index([facturable])
  @@index([facturee])
  @@index([entrepriseId, date])
  @@index([entrepriseId, userId])
  @@index([missionId, facturee])
}

// ============================================================================
// COMPTABILITE - Échéances fiscales
// ============================================================================

model EcheanceFiscale {
  id String @id @default(cuid())

  // Lien avec le dossier/mission
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Lien direct avec le client (pour faciliter les requêtes)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Type d'échéance
  type    TypeDossierComptable
  libelle String // Ex: "TVA CA3 Octobre 2024", "Bilan 2023"

  // Dates
  dateEcheance    DateTime // Date limite légale
  dateRealisation DateTime? // Date de réalisation effective
  dateDepot       DateTime? // Date de dépôt aux impôts

  // Statut et suivi
  statut      StatutEcheance      @default(A_VENIR)
  periodicite PeriodiciteEcheance @default(PONCTUEL)

  // Informations complémentaires
  exerciceFiscal String? // Ex: "2024", "2024-2025"
  periodeDebut   DateTime? // Début de la période concernée
  periodeFin     DateTime? // Fin de la période concernée
  montant        Float? // Montant déclaré (si applicable)
  reference      String? // Référence du dépôt / numéro de formulaire
  notes          String? // Notes internes

  // Rappels
  rappelEnvoye Boolean   @default(false)
  dateRappel   DateTime?

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([missionId])
  @@index([clientId])
  @@index([dateEcheance])
  @@index([statut])
  @@index([type])
  @@index([entrepriseId, dateEcheance])
  @@index([entrepriseId, statut])
  @@index([clientId, dateEcheance])
}

// ============================================================================
// JURIDIQUE - Cabinets d'avocats et juristes
// ============================================================================

// Domaine de droit de l'affaire
enum DomaineJuridique {
  CIVIL // Droit civil général
  FAMILLE // Droit de la famille (divorce, garde, succession)
  PENAL // Droit pénal
  COMMERCIAL // Droit commercial et des affaires
  SOCIAL // Droit du travail
  IMMOBILIER // Droit immobilier
  ADMINISTRATIF // Droit administratif
  FISCAL // Droit fiscal
  PROPRIETE_INTELLECTUELLE // Propriété intellectuelle, marques, brevets
  CONSOMMATION // Droit de la consommation
  ASSURANCE // Droit des assurances
  BANCAIRE // Droit bancaire
  SOCIETES // Droit des sociétés
  CONSTRUCTION // Droit de la construction
  ENVIRONNEMENT // Droit de l'environnement
  NUMERIQUE // Droit du numérique, RGPD
  AUTRE // Autre domaine
}

// Type de procédure
enum TypeProcedure {
  CONTENTIEUX // Procédure contentieuse (litige)
  AMIABLE // Règlement amiable, médiation
  CONSEIL // Mission de conseil pure
  REDACTION // Rédaction d'actes
  NEGOCIATION // Négociation contractuelle
  AUDIT // Audit juridique
  RECOUVREMENT // Recouvrement de créances
  EXECUTION // Exécution de décision
}

// Juridiction compétente
enum Juridiction {
  // Juridictions civiles
  TRIBUNAL_JUDICIAIRE // TJ (ex-TGI)
  TRIBUNAL_PROXIMITE // Tribunal de proximité
  TRIBUNAL_COMMERCE // Tribunal de commerce
  CONSEIL_PRUDHOMMES // Conseil de prud'hommes

  // Juridictions pénales
  TRIBUNAL_POLICE // Tribunal de police (contraventions)
  TRIBUNAL_CORRECTIONNEL // Tribunal correctionnel (délits)
  COUR_ASSISES // Cour d'assises (crimes)
  JUGE_INSTRUCTION // Cabinet d'instruction

  // Cours d'appel et cassation
  COUR_APPEL // Cour d'appel
  COUR_CASSATION // Cour de cassation

  // Juridictions administratives
  TRIBUNAL_ADMINISTRATIF // Tribunal administratif
  COUR_ADMINISTRATIVE_APPEL // Cour administrative d'appel
  CONSEIL_ETAT // Conseil d'État

  // Autres
  MEDIATEUR // Médiateur
  ARBITRAGE // Tribunal arbitral
  JAF // Juge aux affaires familiales
  JEX // Juge de l'exécution
  AUTRE // Autre juridiction
}

// Statut d'une affaire juridique
enum StatutAffaire {
  ETUDE // En cours d'étude / prise en charge
  INSTRUCTION // Phase d'instruction
  MISE_EN_ETAT // Mise en état
  AUDIENCE // Audience fixée
  DELIBERE // En délibéré
  DECISION // Décision rendue
  APPEL // En appel
  EXECUTEE // Exécution en cours
  CLOTUREE // Affaire clôturée
  ARCHIVEE // Affaire archivée
}

// Type d'échéance procédurale
enum TypeEcheanceProcedurale {
  AUDIENCE // Date d'audience
  CONCLUSIONS // Dépôt de conclusions
  PIECES // Communication de pièces
  RECOURS // Délai de recours (appel, cassation)
  SIGNIFICATION // Signification d'acte
  EXECUTION // Délai d'exécution
  PRESCRIPTION // Délai de prescription
  MEDIATION // Séance de médiation
  EXPERTISE // Opérations d'expertise
  COMPARUTION // Comparution
  DELIBERE // Délibéré
  DECISION // Date de décision
  AUTRE // Autre échéance
}

// Statut d'une échéance procédurale
enum StatutEcheanceProcedurale {
  A_VENIR // Échéance à venir
  EN_PREPARATION // En cours de préparation
  PRET // Documents prêts
  EFFECTUEE // Échéance effectuée
  REPORTEE // Reportée
  ANNULEE // Annulée
}

// Type d'honoraires
enum TypeHonoraires {
  TEMPS_PASSE // Facturation au temps passé
  FORFAIT // Honoraires forfaitaires
  RESULTAT // Honoraires de résultat
  MIXTE // Forfait + temps passé ou résultat
  AIDE_JURIDICTIONNELLE // Aide juridictionnelle
}

// Qualité d'une partie
enum QualitePartie {
  DEMANDEUR // Demandeur (qui introduit l'action)
  DEFENDEUR // Défendeur
  PARTIE_CIVILE // Partie civile (pénal)
  PREVENU // Prévenu (pénal)
  ACCUSE // Accusé (assises)
  APPELANT // Appelant
  INTIME // Intimé (appel)
  INTERVENANT // Intervenant volontaire/forcé
  TIERS // Tiers
}

// Type de diligence (action effectuée)
enum TypeDiligence {
  CONSULTATION // Consultation client
  RECHERCHE // Recherches juridiques
  REDACTION // Rédaction d'actes/conclusions
  AUDIENCE // Présence à l'audience
  NEGOCIATION // Négociation
  CORRESPONDANCE // Courriers, emails
  TELEPHONE // Appels téléphoniques
  REUNION // Réunion
  DEPLACEMENT // Déplacement
  EXPERTISE // Participation expertise
  ADMINISTRATIF // Formalités administratives
  AUTRE // Autre diligence
}

// Affaire juridique (dossier client)
model Affaire {
  id          String  @id @default(cuid())
  reference   String // Référence interne: AFF-2024-001
  intitule    String // Intitulé de l'affaire
  description String? @db.Text

  // Client
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  qualiteClient QualitePartie @default(DEMANDEUR)

  // Classification
  domaine       DomaineJuridique
  typeProcedure TypeProcedure    @default(CONTENTIEUX)
  juridiction   Juridiction?
  chambre       String? // Chambre du tribunal

  // Numéros de procédure
  numeroRG      String? // Numéro de rôle général
  numeroParquet String? // Numéro parquet (pénal)

  // Dates clés
  dateOuverture DateTime  @default(now())
  dateFaits     DateTime? // Date des faits litigieux
  dateCloture   DateTime?

  // Parties adverses
  parties PartieAdverse[]

  // Honoraires
  typeHonoraires TypeHonoraires @default(TEMPS_PASSE)
  tauxHoraire    Decimal?       @db.Decimal(10, 2)
  montantForfait Decimal?       @db.Decimal(10, 2)
  provision      Decimal?       @db.Decimal(10, 2) // Provision versée
  montantAJ      Decimal?       @db.Decimal(10, 2) // Montant aide juridictionnelle

  // Enjeu financier
  enjeuFinancier Decimal? @db.Decimal(12, 2)

  // Statut
  statut StatutAffaire @default(ETUDE)

  // Relations
  echeances  EcheanceProcedurale[]
  diligences Diligence[] // Temps passé et actions sur l'affaire

  // Avocat en charge (si plusieurs dans le cabinet)
  responsableId String?

  // Documents liés (via Document existant)
  devisId String? // Convention d'honoraires

  // Conflit d'intérêts vérifié
  conflitVerifie   Boolean   @default(false)
  dateVerifConflit DateTime?

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index pour performances
  @@index([entrepriseId])
  @@index([clientId])
  @@index([statut])
  @@index([domaine])
  @@index([juridiction])
  @@index([dateOuverture])
  @@index([entrepriseId, statut])
  @@index([entrepriseId, domaine])
  @@index([numeroRG])
}

// Partie adverse dans une affaire
model PartieAdverse {
  id String @id @default(cuid())

  affaireId String
  affaire   Affaire @relation(fields: [affaireId], references: [id], onDelete: Cascade)

  // Identification
  nom           String
  prenom        String?
  raisonSociale String? // Si personne morale
  qualite       QualitePartie

  // Contact
  adresse   String?
  email     String?
  telephone String?

  // Représentation
  avocat          String? // Nom de l'avocat adverse
  avocatBarreau   String? // Barreau de l'avocat adverse
  avocatEmail     String?
  avocatTelephone String?

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affaireId])
  @@index([entrepriseId])
  @@index([nom])
}

// Échéance procédurale
model EcheanceProcedurale {
  id String @id @default(cuid())

  affaireId String
  affaire   Affaire @relation(fields: [affaireId], references: [id], onDelete: Cascade)

  // Type et libellé
  type        TypeEcheanceProcedurale
  libelle     String // Ex: "Audience de plaidoirie", "Dépôt conclusions n°2"
  description String?                 @db.Text

  // Dates
  dateEcheance DateTime
  heureDebut   String? // Format "HH:MM"
  heureFin     String?

  // Lieu (si audience/expertise)
  lieu String? // Salle d'audience, adresse expertise

  // Statut
  statut StatutEcheanceProcedurale @default(A_VENIR)

  // Résultat (après l'échéance)
  resultat String? @db.Text // Notes sur ce qui s'est passé

  // Rappels
  rappel1Envoye Boolean @default(false) // Rappel 7 jours avant
  rappel2Envoye Boolean @default(false) // Rappel 1 jour avant

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affaireId])
  @@index([entrepriseId])
  @@index([dateEcheance])
  @@index([type])
  @@index([statut])
  @@index([entrepriseId, dateEcheance])
}

// Diligence (action effectuée sur un dossier)
model Diligence {
  id String @id @default(cuid())

  affaireId String
  affaire   Affaire @relation(fields: [affaireId], references: [id], onDelete: Cascade)

  // Type et description
  type        TypeDiligence
  description String        @db.Text

  // Date et durée
  date  DateTime
  duree Int // Durée en minutes

  // Facturation
  facturable  Boolean @default(true)
  tauxHoraire Decimal @db.Decimal(10, 2)
  montant     Decimal @db.Decimal(10, 2) // Calculé ou override

  // Facturé ?
  facturee  Boolean @default(false)
  factureId String?

  // Utilisateur qui a effectué la diligence
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affaireId])
  @@index([entrepriseId])
  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([facturee])
  @@index([entrepriseId, date])
}

// ============================================
// IMMOBILIER - MODÈLES COMMUNS
// ============================================

enum TypeBien {
  APPARTEMENT
  MAISON
  TERRAIN
  LOCAL_COMMERCIAL
  BUREAU
  PARKING
  CAVE
  IMMEUBLE
  AUTRE
}

enum StatutBien {
  DISPONIBLE
  SOUS_COMPROMIS
  VENDU
  LOUE
  RETIRE
  EN_ATTENTE
}

model BienImmobilier {
  id        String @id @default(cuid())
  reference String // Référence interne unique

  // Type et statut
  typeBien TypeBien
  statut   StatutBien @default(DISPONIBLE)

  // Transaction
  enVente      Boolean  @default(false)
  enLocation   Boolean  @default(false)
  prixVente    Decimal? @db.Decimal(12, 2)
  prixLocation Decimal? @db.Decimal(10, 2) // Loyer mensuel
  chargesLoc   Decimal? @db.Decimal(10, 2)

  // Localisation
  adresse    String
  codePostal String
  ville      String
  pays       String  @default("France")
  etage      Int?
  ascenseur  Boolean @default(false)
  latitude   Float?
  longitude  Float?

  // Caractéristiques
  surface       Decimal  @db.Decimal(10, 2) // m²
  nbPieces      Int
  nbChambres    Int?
  nbSallesBains Int?
  nbWc          Int?
  balcon        Boolean  @default(false)
  terrasse      Boolean  @default(false)
  jardin        Boolean  @default(false)
  surfaceJardin Decimal? @db.Decimal(10, 2)
  parking       Boolean  @default(false)
  garage        Boolean  @default(false)
  cave          Boolean  @default(false)
  piscine       Boolean  @default(false)

  // Construction
  anneeConstruction Int?
  etatGeneral       String? // Neuf, Bon, À rafraîchir, À rénover

  // DPE et diagnostics
  dpeConsommation  String? // A, B, C, D, E, F, G
  dpeEmission      String? // A, B, C, D, E, F, G
  datesDiagnostics DateTime?

  // Copropriété (si applicable)
  enCopropriete   Boolean  @default(false)
  nbLotsCopro     Int?
  chargesCopro    Decimal? @db.Decimal(10, 2)
  procedureSyndic Boolean  @default(false)

  // Description
  titre       String
  description String? @db.Text

  // Photos et médias
  photos    Json? // Array of URLs
  visite360 String? // URL visite virtuelle
  video     String? // URL vidéo

  // Propriétaire (peut être un client)
  proprietaire   Client? @relation("BiensProprietaire", fields: [proprietaireId], references: [id])
  proprietaireId String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  mandats     MandatImmobilier[]
  visites     VisiteImmobilier[]
  estimations EstimationBien[]
  diffusions  DiffusionAnnonce[]
  baux        BailLocatif[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, reference])
  @@index([entrepriseId])
  @@index([typeBien])
  @@index([statut])
  @@index([ville])
  @@index([prixVente])
  @@index([prixLocation])
}

// ============================================
// AGENT IMMOBILIER - MANDATS ET TRANSACTIONS
// ============================================

enum TypeMandat {
  VENTE_EXCLUSIF
  VENTE_SIMPLE
  LOCATION_EXCLUSIF
  LOCATION_SIMPLE
  RECHERCHE // Mandat de recherche
}

enum StatutMandat {
  EN_COURS
  SOUS_COMPROMIS
  VENDU
  LOUE
  EXPIRE
  ANNULE
}

model MandatImmobilier {
  id     String @id @default(cuid())
  numero String // Numéro de mandat (registre)

  // Type et statut
  typeMandat TypeMandat
  statut     StatutMandat @default(EN_COURS)

  // Dates
  dateSignature DateTime
  dateDebut     DateTime
  dateFin       DateTime // Date d'expiration

  // Prix
  prixMandat  Decimal  @db.Decimal(12, 2) // Prix demandé
  prixMinimum Decimal? @db.Decimal(12, 2) // Prix minimum accepté

  // Honoraires
  tauxHonoraires Decimal  @db.Decimal(5, 2) // % honoraires
  honorairesHT   Decimal? @db.Decimal(10, 2)
  honorairesTTC  Decimal? @db.Decimal(10, 2)
  chargeVendeur  Boolean  @default(true) // true = vendeur, false = acquéreur

  // Bien concerné
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Propriétaire mandant
  mandant   Client @relation("MandatsClient", fields: [mandantId], references: [id])
  mandantId String

  // Agent en charge
  agent   Employee? @relation("MandatAgent", fields: [agentId], references: [id])
  agentId String?

  // Document signé
  documentSigneUrl String?

  // Notes
  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  visites VisiteImmobilier[]
  offres  OffreAchat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([statut])
  @@index([typeMandat])
  @@index([dateFin])
}

enum StatutVisite {
  PLANIFIEE
  CONFIRMEE
  EFFECTUEE
  ANNULEE
  ABSENT
}

model VisiteImmobilier {
  id String @id @default(cuid())

  // Planification
  dateVisite DateTime
  duree      Int          @default(30) // minutes
  statut     StatutVisite @default(PLANIFIEE)

  // Bien visité
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Mandat (optionnel)
  mandat   MandatImmobilier? @relation(fields: [mandatId], references: [id])
  mandatId String?

  // Visiteur (acquéreur potentiel)
  visiteur   Client @relation("VisitesAcquereur", fields: [visiteurId], references: [id])
  visiteurId String

  // Agent accompagnateur
  agent   Employee? @relation("VisiteAgent", fields: [agentId], references: [id])
  agentId String?

  // Compte-rendu
  compteRendu   String? @db.Text
  interesseNote Int? // Note d'intérêt 1-5

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([dateVisite])
  @@index([statut])
  @@index([bienId])
  @@index([visiteurId])
}

model EstimationBien {
  id String @id @default(cuid())

  // Bien estimé
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Estimation
  prixEstimeBas  Decimal @db.Decimal(12, 2)
  prixEstimeHaut Decimal @db.Decimal(12, 2)
  prixRecommande Decimal @db.Decimal(12, 2)

  // Méthode
  methode     String? // Comparative, DCF, etc.
  comparables Json? // Biens comparables utilisés

  // Agent
  agent   Employee? @relation("EstimationAgent", fields: [agentId], references: [id])
  agentId String?

  // Document généré
  rapportUrl String?

  dateEstimation DateTime @default(now())
  validiteJours  Int      @default(90)

  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([bienId])
  @@index([dateEstimation])
}

enum StatutOffre {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  CONTRE_OFFRE
  EXPIREE
  RETIREE
}

model OffreAchat {
  id String @id @default(cuid())

  // Offre
  montant      Decimal     @db.Decimal(12, 2)
  dateOffre    DateTime    @default(now())
  dateValidite DateTime
  statut       StatutOffre @default(EN_ATTENTE)

  // Conditions
  conditions      String?  @db.Text // Conditions suspensives
  financement     String? // Type de financement
  apportPersonnel Decimal? @db.Decimal(12, 2)

  // Mandat concerné
  mandat   MandatImmobilier @relation(fields: [mandatId], references: [id])
  mandatId String

  // Acquéreur
  acquereur   Client @relation("OffresAcquereur", fields: [acquereurId], references: [id])
  acquereurId String

  // Réponse
  dateReponse       DateTime?
  contreProposition Decimal?  @db.Decimal(12, 2)
  motifRefus        String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([mandatId])
  @@index([statut])
}

// ============================================
// AGENT IMMOBILIER - DIFFUSION ANNONCES
// ============================================

enum PortailDiffusion {
  SELOGER
  LEBONCOIN
  BIEN_ICI
  LOGIC_IMMO
  PAP
  FIGARO_IMMO
  GREEN_ACRES // International
  SITE_AGENCE
  AUTRE
}

enum StatutDiffusion {
  BROUILLON // Non publié
  EN_ATTENTE // En attente de validation portail
  ACTIVE // Publiée et active
  PAUSE // Mise en pause temporaire
  EXPIREE // Expirée automatiquement
  REFUSEE // Refusée par le portail
  ERREUR // Erreur technique
}

enum TypeAnnonce {
  STANDARD
  PREMIUM // Mise en avant payante
  BOOST // Boost temporaire
  VITRINE // Position vitrine
}

// Configuration des portails (settings par entreprise)
model ConfigurationPortail {
  id String @id @default(cuid())

  portail PortailDiffusion
  actif   Boolean          @default(false)

  // Credentials (simulés pour l'instant)
  identifiant String?
  cleApi      String? // Encrypted
  agenceId    String? // ID agence sur le portail

  // Options de diffusion par défaut
  typeAnnonceDefaut  TypeAnnonce @default(STANDARD)
  dureeDefautJours   Int         @default(30)
  autoRenouvellement Boolean     @default(true)

  // Limites du compte (simulé)
  creditsDispo Int @default(100)
  annoncesMax  Int @default(50)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, portail])
  @@index([entrepriseId])
}

model DiffusionAnnonce {
  id String @id @default(cuid())

  // Bien diffusé
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Portail et type
  portail     PortailDiffusion
  typeAnnonce TypeAnnonce      @default(STANDARD)
  statut      StatutDiffusion  @default(BROUILLON)

  // Identifiants externes (comme si c'était réel)
  referenceExterne String? // ID sur le portail (ex: "SL-123456")
  urlAnnonce       String? // URL de l'annonce sur le portail

  // Contenu personnalisé par portail (peut différer du bien)
  titreAnnonce        String? // Titre spécifique au portail
  descriptionAnnonce  String? @db.Text // Description adaptée
  photosSelectionnees Json? // IDs des photos à diffuser (ordre spécifique)

  // Options payantes (simulées)
  optionBoost   Boolean @default(false)
  optionUrgent  Boolean @default(false)
  optionPhotoHD Boolean @default(false)
  coutCredits   Int     @default(1) // Coût en crédits

  // Statistiques (simulées avec des données réalistes)
  nbVues           Int      @default(0)
  nbVuesUniques    Int      @default(0)
  nbClicsContact   Int      @default(0)
  nbClicsTelephone Int      @default(0)
  nbFavoris        Int      @default(0)
  nbPartages       Int      @default(0)
  positionMoyenne  Decimal? @db.Decimal(5, 2) // Position dans les résultats

  // Statistiques par période (JSON)
  statsHebdo      Json? // { "2024-W01": { vues: 150, contacts: 5 }, ... }
  statsMensuelles Json? // { "2024-01": { vues: 600, contacts: 20 }, ... }

  // Dates
  datePublication        DateTime?
  dateExpiration         DateTime?
  dateDerniereModif      DateTime?
  derniereSynchro        DateTime?
  prochainRenouvellement DateTime?

  // Historique des remontées/boost
  historiqueBooosts Json? // [{ date: "...", duree: 7, cout: 5 }, ...]

  // Logs et erreurs
  erreurMessage String?
  logsSync      Json? // Historique des synchros

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  leads LeadPortail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bienId, portail])
  @@index([entrepriseId])
  @@index([portail])
  @@index([statut])
  @@index([dateExpiration])
}

// Leads générés par les portails (contacts entrants)
model LeadPortail {
  id String @id @default(cuid())

  // Source
  diffusion   DiffusionAnnonce @relation(fields: [diffusionId], references: [id])
  diffusionId String
  portail     PortailDiffusion

  // Contact
  nom       String
  prenom    String?
  email     String
  telephone String?
  message   String? @db.Text

  // Qualification
  budget        Decimal? @db.Decimal(12, 2)
  delaiAchat    String? // "Immédiat", "3 mois", "6 mois", "1 an"
  financementOk Boolean?
  dejaProprio   Boolean?

  // Statut du lead
  statut       String    @default("nouveau") // nouveau, contacte, qualifie, rdv, perdu
  dateContact  DateTime?
  agentAssigne Employee? @relation("LeadAgentResponsable", fields: [agentId], references: [id])
  agentId      String?

  // Converti en client ?
  clientConverti Client? @relation("LeadsConvertis", fields: [clientId], references: [id])
  clientId       String?

  dateReception DateTime @default(now())
  notes         String?  @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([diffusionId])
  @@index([statut])
  @@index([dateReception])
}

// Matching acquéreurs
model RechercheAcquereur {
  id String @id @default(cuid())

  // Acquéreur
  acquereur   Client @relation("RecherchesAcquereur", fields: [acquereurId], references: [id])
  acquereurId String

  // Critères de recherche
  typesBiens TypeBien[] // Types recherchés
  enAchat    Boolean    @default(true)
  enLocation Boolean    @default(false)

  // Budget
  budgetMin Decimal? @db.Decimal(12, 2)
  budgetMax Decimal? @db.Decimal(12, 2)
  loyerMax  Decimal? @db.Decimal(10, 2)

  // Localisation
  villesRecherchees String[] // Array de villes
  codesPostaux      String[]
  rayonKm           Int? // Rayon de recherche

  // Surface
  surfaceMin    Decimal? @db.Decimal(10, 2)
  surfaceMax    Decimal? @db.Decimal(10, 2)
  nbPiecesMin   Int?
  nbPiecesMax   Int?
  nbChambresMin Int?

  // Critères optionnels
  avecJardin             Boolean?
  avecParking            Boolean?
  avecAscenseur          Boolean?
  rdcUniquement          Boolean  @default(false)
  dernierEtageUniquement Boolean  @default(false)

  // DPE
  dpeMaximum String? // A, B, C, D, E

  // Statut
  actif   Boolean @default(true)
  urgence Int     @default(3) // 1=très urgent, 5=pas pressé

  notes String? @db.Text

