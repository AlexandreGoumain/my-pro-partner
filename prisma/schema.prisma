  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([acquereurId])
  @@index([actif])
}

// ============================================
// GESTION LOCATIVE - BAUX ET LOYERS
// ============================================

enum TypeBail {
  HABITATION_VIDE
  HABITATION_MEUBLEE
  COMMERCIAL
  PROFESSIONNEL
  MIXTE
  SAISONNIER
}

enum StatutBail {
  EN_COURS
  PREAVIS
  TERMINE
  RESILIE
}

model BailLocatif {
  id        String @id @default(cuid())
  reference String

  // Type et statut
  typeBail TypeBail
  statut   StatutBail @default(EN_COURS)

  // Bien loué
  bien   BienImmobilier @relation(fields: [bienId], references: [id])
  bienId String

  // Locataire principal
  locatairePrincipal Client @relation("BauxLocataire", fields: [locataireId], references: [id])
  locataireId        String

  // Propriétaire (si gestion pour compte)
  proprietaire   Client? @relation("BauxProprietaire", fields: [proprietaireId], references: [id])
  proprietaireId String?

  // Dates
  dateSignature DateTime
  dateDebut     DateTime
  dateFin       DateTime? // null si bail reconductible
  dureeMois     Int // 12, 36, etc.

  // Loyer
  loyerHC    Decimal @db.Decimal(10, 2) // Hors charges
  provisions Decimal @db.Decimal(10, 2) // Provisions sur charges
  loyerCC    Decimal @db.Decimal(10, 2) // Charges comprises (calculé)

  // Dépôt de garantie
  depotGarantie      Decimal   @db.Decimal(10, 2)
  depotRecu          Boolean   @default(false)
  dateReceptionDepot DateTime?

  // Révision
  indiceReference String? // IRL
  dateRevision    DateTime? // Date de révision annuelle

  // Preavis
  dureePreavisMois Int       @default(3) // 1, 3 ou 6 mois
  dateCongeRecu    DateTime?
  dateFinPreavis   DateTime?

  // Assurance
  assuranceLocataire   Boolean @default(false)
  attestationAssurance String?

  // Documents
  documentBailUrl String?

  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  loyers     AppelLoyer[]
  etatsLieux EtatDesLieux[]
  incidents  IncidentLocatif[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, reference])
  @@index([entrepriseId])
  @@index([statut])
  @@index([locataireId])
  @@index([bienId])
}

enum StatutLoyer {
  A_ENVOYER
  ENVOYE
  PAYE
  PARTIELLEMENT_PAYE
  IMPAYE
  EN_CONTENTIEUX
}

model AppelLoyer {
  id     String @id @default(cuid())
  numero String

  // Bail concerné
  bail   BailLocatif @relation(fields: [bailId], references: [id])
  bailId String

  // Période
  mois         Int // 1-12
  annee        Int
  dateEcheance DateTime

  // Montants
  loyerHC    Decimal @db.Decimal(10, 2)
  provisions Decimal @db.Decimal(10, 2)
  totalDu    Decimal @db.Decimal(10, 2)

  // Paiement
  statut       StatutLoyer @default(A_ENVOYER)
  montantPaye  Decimal     @default(0) @db.Decimal(10, 2)
  datePaiement DateTime?
  modePaiement String? // Virement, prélèvement, chèque

  // Quittance
  quittanceGeneree   Boolean   @default(false)
  quittanceUrl       String?
  dateEnvoiQuittance DateTime?

  // Relances
  nbRelances      Int       @default(0)
  derniereRelance DateTime?

  notes String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bailId, mois, annee])
  @@index([entrepriseId])
  @@index([statut])
  @@index([dateEcheance])
}

enum TypeEtatLieux {
  ENTREE
  SORTIE
}

model EtatDesLieux {
  id String @id @default(cuid())

  // Bail concerné
  bail   BailLocatif @relation(fields: [bailId], references: [id])
  bailId String

  // Type et date
  typeEtat TypeEtatLieux
  dateEtat DateTime

  // Relevés compteurs
  releveEau  Decimal? @db.Decimal(10, 2)
  releveElec Decimal? @db.Decimal(10, 2)
  releveGaz  Decimal? @db.Decimal(10, 2)

  // Constatations par pièce (JSON)
  constatations Json? // { "salon": { "etat": "bon", "remarques": "..." }, ... }

  // Photos
  photos Json? // Array of URLs

  // Signatures
  signatureLocataire    String? // URL signature
  signatureProprietaire String?
  dateSignature         DateTime?

  // Retenue sur dépôt (sortie uniquement)
  retenueDepot Decimal? @db.Decimal(10, 2)
  motifRetenue String?  @db.Text

  // Document
  documentUrl String?

  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([bailId])
  @@index([typeEtat])
}

enum StatutIncident {
  SIGNALE
  EN_COURS
  DEVIS_DEMANDE
  TRAVAUX_PLANIFIES
  RESOLU
  ANNULE
}

model IncidentLocatif {
  id String @id @default(cuid())

  // Bail concerné
  bail   BailLocatif @relation(fields: [bailId], references: [id])
  bailId String

  // Incident
  dateSignalement DateTime @default(now())
  description     String   @db.Text
  categorie       String // Plomberie, Électricité, Chauffage, etc.
  urgence         Int      @default(3) // 1=urgent, 5=non urgent

  // Statut
  statut StatutIncident @default(SIGNALE)

  // Photos
  photos Json?

  // Intervention
  dateIntervention DateTime?
  prestataire      String?
  coutEstime       Decimal?  @db.Decimal(10, 2)
  coutReel         Decimal?  @db.Decimal(10, 2)
  aChargeDe        String? // "locataire" ou "proprietaire"

  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([bailId])
  @@index([statut])
}

// ============================================
// SYNDIC COPROPRIETE
// ============================================

model Copropriete {
  id        String @id @default(cuid())
  reference String
  nom       String // Nom de la copropriété

  // Adresse
  adresse    String
  codePostal String
  ville      String

  // Caractéristiques
  nbBatiments    Int @default(1)
  nbLots         Int
  totalTantiemes Int // Total des tantièmes (souvent 10000)

  // Immatriculation
  numeroImmatriculation String?
  dateImmatriculation   DateTime?

  // Dates
  dateCreation    DateTime? // Date création copropriété
  datePriseSyndic DateTime // Date prise en charge
  dateFinMandat   DateTime?

  // Comptes bancaires
  comptePrincipal String? // IBAN compte principal
  compteTravaux   String? // IBAN compte travaux (Alur)

  // Règlement
  reglementCopro String? // URL règlement

  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  lots            LotCopropriete[]
  appelsCharges   AppelCharges[]
  assemblees      AssembleeGenerale[]
  travauxCopro    TravauxCopropriete[]
  compteCopro     CompteCopropriete[]
  conseilSyndical MembreConseilSyndical[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, reference])
  @@index([entrepriseId])
  @@index([ville])
}

enum TypeLot {
  APPARTEMENT
  PARKING
  CAVE
  LOCAL_COMMERCIAL
  BUREAU
  CHAMBRE_SERVICE
  AUTRE
}

model LotCopropriete {
  id     String @id @default(cuid())
  numero String // Numéro de lot

  // Type
  typeLot  TypeLot
  etage    Int?
  batiment String? // A, B, C...

  // Surface et tantièmes
  surface               Decimal? @db.Decimal(10, 2)
  tantiemesGeneraux     Int // Tantièmes parties communes générales
  tantiemesParticuliers Json? // { "ascenseur": 150, "chauffage": 200 }

  // Copropriété
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  coproprieteId String

  // Copropriétaire actuel
  coproprietaire   Client? @relation("LotsCoproprietaire", fields: [coproprietaireId], references: [id])
  coproprietaireId String?

  // Si loué
  estLoue     Boolean @default(false)
  locataire   Client? @relation("LotsLocataire", fields: [locataireId], references: [id])
  locataireId String?

  notes String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  appelsCharges LigneAppelCharges[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coproprieteId, numero])
  @@index([entrepriseId])
  @@index([coproprieteId])
  @@index([coproprietaireId])
}

enum TypeAppelCharges {
  BUDGET_PREVISIONNEL
  TRAVAUX
  REGULARISATION
  EXCEPTIONNEL
}

enum StatutAppelCharges {
  BROUILLON
  ENVOYE
  PARTIELLEMENT_PAYE
  PAYE
  IMPAYE
}

model AppelCharges {
  id     String @id @default(cuid())
  numero String

  // Copropriété
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  coproprieteId String

  // Type et période
  typeAppel    TypeAppelCharges
  trimestre    Int? // 1-4
  annee        Int
  dateEcheance DateTime

  // Montant total
  montantTotal Decimal @db.Decimal(12, 2)

  // Statut
  statut    StatutAppelCharges @default(BROUILLON)
  dateEnvoi DateTime?

  notes String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  lignes LigneAppelCharges[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coproprieteId, numero])
  @@index([entrepriseId])
  @@index([coproprieteId])
  @@index([statut])
  @@index([annee])
}

model LigneAppelCharges {
  id String @id @default(cuid())

  // Appel parent
  appel   AppelCharges @relation(fields: [appelId], references: [id])
  appelId String

  // Lot concerné
  lot   LotCopropriete @relation(fields: [lotId], references: [id])
  lotId String

  // Montant
  montantDu    Decimal   @db.Decimal(10, 2)
  montantPaye  Decimal   @default(0) @db.Decimal(10, 2)
  datePaiement DateTime?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appelId])
  @@index([lotId])
  @@index([entrepriseId])
}

enum TypeAG {
  ORDINAIRE
  EXTRAORDINAIRE
}

enum StatutAG {
  PLANIFIEE
  CONVOCATIONS_ENVOYEES
  EN_COURS
  TERMINEE
  PV_ENVOYE
}

model AssembleeGenerale {
  id String @id @default(cuid())

  // Copropriété
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  coproprieteId String

  // Type et dates
  typeAG     TypeAG   @default(ORDINAIRE)
  dateAG     DateTime
  heureDebut String // "18:30"
  lieu       String

  // Statut
  statut StatutAG @default(PLANIFIEE)

  // Convocation
  dateConvocation  DateTime?
  delaiConvocation Int       @default(21) // jours

  // Ordre du jour
  ordreJour Json? // Array de résolutions

  // Résultats
  nbPresents        Int?
  nbRepresentes     Int?
  tantiemesPresents Int?
  quorum            Boolean?

  // Documents
  convocationUrl String?
  pvUrl          String?

  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  resolutions ResolutionAG[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([coproprieteId])
  @@index([dateAG])
  @@index([statut])
}

enum ResultatVote {
  ADOPTEE
  REJETEE
  REPORTEE
  NON_VOTEE
}

enum TypeMajorite {
  SIMPLE // Article 24
  ABSOLUE // Article 25
  DOUBLE // Article 26
  UNANIMITE
}

model ResolutionAG {
  id     String @id @default(cuid())
  numero Int // Numéro de résolution dans l'AG

  // AG
  assemblee   AssembleeGenerale @relation(fields: [assembleeId], references: [id])
  assembleeId String

  // Contenu
  titre        String
  description  String?      @db.Text
  typeMajorite TypeMajorite

  // Vote
  resultat      ResultatVote?
  voixPour      Int?
  voixContre    Int?
  abstentions   Int?
  tantiemesPour Int?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assembleeId])
  @@index([entrepriseId])
}

enum StatutTravauxCopro {
  PROJET
  VOTE
  EN_COURS
  TERMINE
  ANNULE
}

model TravauxCopropriete {
  id String @id @default(cuid())

  // Copropriété
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  coproprieteId String

  // Travaux
  titre       String
  description String? @db.Text
  categorie   String // Ravalement, Toiture, Ascenseur, etc.

  // Statut
  statut StatutTravauxCopro @default(PROJET)

  // Budget
  budgetEstime Decimal? @db.Decimal(12, 2)
  budgetVote   Decimal? @db.Decimal(12, 2)
  coutFinal    Decimal? @db.Decimal(12, 2)

  // Dates
  dateDebutPrevue DateTime?
  dateFinPrevue   DateTime?
  dateDebutReelle DateTime?
  dateFinReelle   DateTime?

  // Entreprise intervenante
  prestataire        String?
  contactPrestataire String?

  // AG de vote
  assembleeVote String? // ID de l'AG où c'est voté

  // Documents
  devis    Json? // Array d'URLs de devis
  factures Json? // Array d'URLs de factures

  notes String? @db.Text

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([coproprieteId])
  @@index([statut])
}

// Comptabilité copropriété
model CompteCopropriete {
  id String @id @default(cuid())

  // Copropriété
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  coproprieteId String

  // Exercice
  exercice  Int // Année de l'exercice
  dateDebut DateTime
  dateFin   DateTime
  cloture   Boolean  @default(false)

  // Budget prévisionnel
  budgetPrevisionnel Decimal @db.Decimal(12, 2)

  // Réalisé
  totalCharges  Decimal @default(0) @db.Decimal(12, 2)
  totalProduits Decimal @default(0) @db.Decimal(12, 2)

  // Solde
  soldeDebut Decimal  @default(0) @db.Decimal(12, 2)
  soldeFin   Decimal? @db.Decimal(12, 2)

  // Documents
  rapportFinancierUrl String?
  annexesComptesUrl   String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coproprieteId, exercice])
  @@index([entrepriseId])
  @@index([coproprieteId])
}

model MembreConseilSyndical {
  id String @id @default(cuid())

  // Copropriété
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  coproprieteId String

  // Membre
  membre   Client @relation("MembresConseilSyndical", fields: [membreId], references: [id])
  membreId String

  // Rôle
  role String // Président, Membre, Trésorier

  // Mandat
  dateDebut DateTime
  dateFin   DateTime?
  actif     Boolean   @default(true)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coproprieteId])
  @@index([membreId])
  @@index([entrepriseId])
}
