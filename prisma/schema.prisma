// ============================================
// ERP ARTISAN - PRISMA SCHEMA (MULTI-TENANT)
// ============================================

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANCY
// ============================================

enum BusinessType {
  GENERAL // Entreprise générique
  PLOMBERIE // Plombier
  ELECTRICITE // Électricien
  CHAUFFAGE // Chauffagiste
  MENUISERIE // Menuisier
  PEINTURE // Peintre
  MACONNERIE // Maçon
  RESTAURATION // Restaurant, café, bar
  BOULANGERIE // Boulangerie, pâtisserie
  COIFFURE // Salon de coiffure
  ESTHETIQUE // Institut de beauté, spa
  FITNESS // Salle de sport, coaching
  GARAGE // Garage automobile
  INFORMATIQUE // Services informatiques
  CONSULTING // Conseil, formation
  COMMERCE_DETAIL // Commerce de détail
  // Immobilier - 3 types spécialisés
  AGENT_IMMOBILIER // Agent immobilier, mandataire (carte T)
  GESTION_LOCATIVE // Administrateur de biens (carte G)
  SYNDIC_COPROPRIETE // Syndic de copropriété
  SANTE // Professions médicales/paramédicales
  JURIDIQUE // Avocat, notaire
  COMPTABILITE // Expert-comptable
}

model Entreprise {
  id    String  @id @default(cuid())
  nom   String
  slug  String? @unique // URL-friendly identifier for client portal registration
  siret String? @unique
  email String  @unique

  // Type de business pour personnalisation
  businessType BusinessType @default(GENERAL)
  secteur      String? // Secteur d'activité détaillé

  // Gestion d'abonnement
  plan            PlanAbonnement @default(FREE)
  abonnementActif Boolean        @default(true)
  dateAbonnement  DateTime       @default(now())
  dateExpiration  DateTime?

  // Gestion de la période d'essai (trial)
  trialActive    Boolean         @default(false)
  trialPlan      PlanAbonnement?
  trialStartDate DateTime?
  trialExpiresAt DateTime?

  // Relations (toutes les données de l'entreprise)
  users            User[]
  stores           Store[] // Magasins/Points de vente
  categories       Categorie[]
  articles         Article[]
  clients          Client[]
  documents        Document[]
  mouvements       MouvementStock[]
  parametres       ParametresEntreprise?
  seriesDocuments  SerieDocument[]
  niveauxFidelite  NiveauFidelite[]
  mouvementsPoints MouvementPoints[]
  segments         Segment[]
  automations      Automation[]
  campaigns        Campaign[]
  conversations    Conversation[]
  subscription     Subscription? // Un abonnement Stripe (optionnel)
  usageCounters    UsageCounter[] // Compteurs d'usage mensuels
  paymentLinks     PaymentLink[] // Liens de paiement
  terminals        Terminal[] // Terminaux de paiement physiques
  bankTransactions BankTransaction[] // Transactions bancaires pour rapprochement
  stockTransfers   StockTransfer[] // Transferts de stock inter-magasins

  // Relations pour système d'occasion (boutiques informatique)
  rachats           RachatArticle[] // Rachats d'articles d'occasion
  demontages        DemontageArticle[] // Démontages effectués
  ressourcesAtelier RessourceAtelier[] // Ressources d'atelier (pièces)
  reparations       Reparation[] // Réparations d'appareils

  // Gestion du personnel
  employees Employee[] // Employés de l'entreprise

  // Relations pour système plomberie
  interventions        Intervention[] // Interventions plomberie
  camionnettes         Camionnette[] // Véhicules/camionnettes
  stocksCamionnette    StockCamionnette[] // Stocks mobiles
  contratsEntretien    ContratEntretien[] // Contrats d'entretien
  entretiensVehicule   EntretienVehicule[] // Entretiens véhicules
  equipementsClients   EquipementClient[] // Parc équipements clients
  certificatsEntretien CertificatEntretien[] // Certificats d'entretien

  // Relations pour système restauration
  tablesRestaurant TableRestaurant[] // Tables du restaurant
  reservations     Reservation[] // Réservations
  menuItems        MenuItem[] // Plats et boissons du menu

  // Relations pour système coiffure / rendez-vous / esthétique
  prestations Prestation[] // Services proposés (coupe, couleur, soin, etc.)
  employes    Employe[] // Employés (coiffeurs, esthéticiennes, etc.)
  rendezVous  RendezVous[] // Rendez-vous clients
  cabines     Cabine[] // Cabines/salles de soins (esthétique, spa)

  // Relations pour système fitness / salle de sport
  typesAbonnementFitness TypeAbonnementFitness[] // Types d'abonnements (mensuel, annuel, etc.)
  abonnementsFitness     AbonnementFitness[] // Abonnements clients
  coursFitness           CoursCollectif[] // Cours collectifs (yoga, spinning, etc.)
  seancesCours           SeanceCours[] // Séances de cours planifiées
  reservationsCours      ReservationCours[] // Réservations aux cours
  sallesFitness          SalleFitness[] // Salles/zones de la salle de sport
  presencesFitness       PresenceFitness[] // Check-ins des membres

  // Relations pour système consulting / services intellectuels
  missions     Mission[] // Missions de consulting
  entreesTemps EntreeTemps[] // Entrées de temps

  // Relations pour système comptabilité
  echeancesFiscales EcheanceFiscale[] // Échéances fiscales

  // Relations pour système juridique (cabinets d'avocats)
  affaires              Affaire[] // Dossiers/affaires juridiques
  partiesAdverses       PartieAdverse[] // Parties adverses
  echeancesProcedurales EcheanceProcedurale[] // Échéances procédurales
  diligences            Diligence[] // Diligences effectuées

  // Relations pour système immobilier
  biensImmobiliers     BienImmobilier[] // Portefeuille de biens
  mandatsImmobiliers   MandatImmobilier[] // Mandats de vente/location
  visitesImmobiliers   VisiteImmobilier[] // Visites planifiées
  estimationsBiens     EstimationBien[] // Estimations réalisées
  offresAchat          OffreAchat[] // Offres d'achat
  configsPortails      ConfigurationPortail[] // Config portails diffusion
  diffusionsAnnonces   DiffusionAnnonce[] // Diffusions vers portails
  leadsPortails        LeadPortail[] // Leads des portails
  recherchesAcquereurs RechercheAcquereur[] // Recherches acquéreurs

  // Relations pour gestion locative
  bailsLocatifs     BailLocatif[] // Baux locatifs
  appelsLoyers      AppelLoyer[] // Appels de loyers
  etatsLieux        EtatDesLieux[] // États des lieux
  incidentsLocatifs IncidentLocatif[] // Incidents/travaux

  // Relations pour syndic copropriété
  coproprietes           Copropriete[] // Copropriétés gérées
  lotsCopropriete        LotCopropriete[] // Lots de copropriété
  appelsCharges          AppelCharges[] // Appels de charges
  lignesAppelsCharges    LigneAppelCharges[] // Lignes d'appels
  assembleesGenerales    AssembleeGenerale[] // Assemblées générales
  resolutionsAG          ResolutionAG[] // Résolutions AG
  travauxCopropriete     TravauxCopropriete[] // Travaux copropriété
  comptesCopropriete     CompteCopropriete[] // Comptabilité copro
  membresConseilSyndical MembreConseilSyndical[] // Membres conseil

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([slug])
  @@index([siret])
  @@index([abonnementActif])
  @@index([businessType])
}

enum PlanAbonnement {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// ============================================
// MULTI-MAGASINS & MULTI-CAISSES
// ============================================

enum StoreStatus {
  ACTIVE // Magasin actif
  INACTIVE // Magasin temporairement fermé
  CLOSED // Magasin fermé définitivement
}

enum RegisterStatus {
  ONLINE // Caisse en ligne
  OFFLINE // Caisse hors ligne
  BUSY // Caisse occupée (transaction en cours)
  CLOSED // Caisse fermée
}

enum TransferStatus {
  PENDING // En attente de validation
  APPROVED // Approuvé, en transit
  RECEIVED // Reçu au magasin destination
  REJECTED // Rejeté
  CANCELLED // Annulé
}

model Store {
  id   String @id @default(cuid())
  nom  String
  code String // Code court du magasin (ex: "PAR01", "LYO01")

  // Localisation
  adresse    String?
  codePostal String?
  ville      String?
  pays       String  @default("France")
  latitude   Float?
  longitude  Float?

  // Contact
  telephone String?
  email     String?

  // Configuration
  isMainStore Boolean     @default(false) // Magasin principal
  status      StoreStatus @default(ACTIVE)
  timezone    String      @default("Europe/Paris")

  // Horaires d'ouverture (JSON)
  // Format: { "1": { "open": "09:00", "close": "19:00" }, ... }
  openingHours Json?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  registers       Register[] // Caisses de ce magasin
  documents       Document[] // Documents émis depuis ce magasin
  mouvementsStock MouvementStock[] // Mouvements de stock de ce magasin
  stockItems      StoreStockItem[] // Stock par magasin
  transfersFrom   StockTransfer[]  @relation("TransferFrom")
  transfersTo     StockTransfer[]  @relation("TransferTo")
  reparations     Reparation[] // Réparations reçues dans ce magasin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, code])
  @@index([entrepriseId])
  @@index([status])
  @@index([isMainStore])
}

model Register {
  id   String @id @default(cuid())
  nom  String // Nom de la caisse (ex: "Caisse 1", "Caisse principale")
  code String // Code court (ex: "C01", "C02")

  // Configuration
  status     RegisterStatus @default(OFFLINE)
  isActive   Boolean        @default(true)
  deviceId   String?        @unique // ID unique de l'appareil
  ipAddress  String?
  terminalId String?        @unique // ID du terminal Stripe/physique associé

  // Options
  canProcessCash    Boolean @default(true)
  canProcessCard    Boolean @default(true)
  canProcessCheck   Boolean @default(true)
  requiresSignature Boolean @default(false)

  // Multi-tenant
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  // Relations
  documents   Document[] // Documents créés depuis cette caisse
  sessions    RegisterSession[] // Sessions d'ouverture/fermeture de caisse
  reparations Reparation[] // Réparations créées depuis cette caisse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
  @@index([status])
  @@index([deviceId])
  @@index([isActive])
}

// Session de caisse (ouverture/fermeture)
model RegisterSession {
  id String @id @default(cuid())

  register   Register @relation(fields: [registerId], references: [id], onDelete: Cascade)
  registerId String

  // Session info
  openedBy String // User ID
  closedBy String? // User ID
  openedAt DateTime  @default(now())
  closedAt DateTime?

  // Montants
  startingCash Decimal  @default(0) @db.Decimal(10, 2) // Fond de caisse
  expectedCash Decimal? @db.Decimal(10, 2) // Attendu (calculé)
  actualCash   Decimal? @db.Decimal(10, 2) // Réel (compté)
  difference   Decimal? @db.Decimal(10, 2) // Écart

  // Statistiques de la session
  totalSales        Decimal @default(0) @db.Decimal(10, 2)
  totalTransactions Int     @default(0)
  cashSales         Decimal @default(0) @db.Decimal(10, 2)
  cardSales         Decimal @default(0) @db.Decimal(10, 2)
  checkSales        Decimal @default(0) @db.Decimal(10, 2)

  // Notes
  openingNotes String?
  closingNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registerId])
  @@index([openedAt])
  @@index([closedAt])
}

// Stock par magasin (pour gérer le stock indépendamment par magasin)
model StoreStockItem {
  id String @id @default(cuid())

  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  // Quantités
  quantite Int @default(0)
  stockMin Int @default(0) // Seuil d'alerte spécifique au magasin
  stockMax Int @default(0) // Stock maximum recommandé

  // Emplacement dans le magasin
  emplacement  String? // Ex: "Rayon A - Étagère 3"
  zoneStockage String? // Ex: "Réserve", "Vitrine"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, articleId])
  @@index([storeId])
  @@index([articleId])
  @@index([quantite]) // Pour les alertes de stock bas
  @@index([storeId, articleId])
}

// Transferts de stock entre magasins
model StockTransfer {
  id        String  @id @default(cuid())
  numero    String  @unique // Numéro de transfert (auto-généré)
  reference String? // Référence externe

  // Magasins
  fromStore   Store  @relation("TransferFrom", fields: [fromStoreId], references: [id])
  fromStoreId String

  toStore   Store  @relation("TransferTo", fields: [toStoreId], references: [id])
  toStoreId String

  // Statut
  status TransferStatus @default(PENDING)

  // Dates
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  shippedAt   DateTime?
  receivedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  // Utilisateurs
  requestedBy String // User ID
  approvedBy  String? // User ID
  receivedBy  String? // User ID

  // Informations de transport
  trackingNumber    String?
  carrier           String? // Transporteur
  estimatedDelivery DateTime?

  // Notes
  notes           String?
  rejectionReason String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  items StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@index([status])
  @@index([requestedAt])
}

// Articles dans un transfert
model StockTransferItem {
  id String @id @default(cuid())

  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId String

  article   Article @relation(fields: [articleId], references: [id])
  articleId String

  quantiteRequested Int // Quantité demandée
  quantiteSent      Int @default(0) // Quantité expédiée
  quantiteReceived  Int @default(0) // Quantité reçue

  notes String? // Notes spécifiques à cet article

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transferId])
  @@index([articleId])
}

// ============================================
// GESTION D'ABONNEMENTS STRIPE
// ============================================

model Subscription {
  id String @id @default(cuid())

  // Relation avec l'entreprise
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String     @unique // Une entreprise = un abonnement

  // Informations Stripe
  stripeCustomerId     String  @unique
  stripeSubscriptionId String  @unique
  stripePriceId        String // Prix Stripe (monthly ou annual)
  stripeProductId      String? // Produit Stripe

  // Plan et statut
  plan   PlanAbonnement
  status SubscriptionStatus @default(ACTIVE)

  // Période de facturation
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // Trial
  trialStart DateTime?
  trialEnd   DateTime?

  // Annulation
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  cancelReason      String?

  // Métadonnées
  metadata Json? // Données additionnelles (coupon, promo, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([plan])
  @@index([currentPeriodEnd])
}

enum SubscriptionStatus {
  ACTIVE // Abonnement actif
  TRIALING // En période d'essai
  PAST_DUE // Paiement en retard
  CANCELED // Annulé
  INCOMPLETE // Paiement initial incomplet
  INCOMPLETE_EXPIRED // Paiement initial expiré
  UNPAID // Impayé
  PAUSED // En pause
}

// Compteurs d'usage mensuels pour les limites
model UsageCounter {
  id String @id @default(cuid())

  // Relation avec l'entreprise
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Période de comptage
  periodStart DateTime
  periodEnd   DateTime

  // Compteurs
  documentsCreated Int @default(0) // Documents créés ce mois
  questionsAsked   Int @default(0) // Questions assistant ce mois

  // Métadonnées JSON pour tracking additionnel si besoin
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, periodStart]) // Un compteur par entreprise par période
  @@index([entrepriseId])
  @@index([periodStart])
  @@index([periodEnd])
}

// ============================================
// AUTHENTIFICATION & GESTION DU PERSONNEL
// ============================================

enum UserRole {
  OWNER // Propriétaire (créateur de l'entreprise)
  ADMIN // Administrateur (accès complet)
  MANAGER // Manager (gestion équipe + clients)
  EMPLOYEE // Employé standard
  CASHIER // Caissier (ventes uniquement)
  ACCOUNTANT // Comptable (finances uniquement)
}

enum UserStatus {
  ACTIVE // Actif
  INACTIVE // Inactif
  SUSPENDED // Suspendu
  INVITED // Invité (pas encore accepté)
  DELETED // Supprimé (soft delete)
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?

  // Rôle et statut
  role   UserRole   @default(EMPLOYEE)
  status UserStatus @default(INVITED)

  // Multi-tenant: chaque user appartient à une entreprise
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Informations personnelles
  prenom        String?
  telephone     String?
  dateNaissance DateTime? @db.Date
  adresse       String?
  codePostal    String?
  ville         String?
  photoUrl      String?

  // Informations professionnelles
  poste          String? // Titre du poste (ex: "Chef de caisse", "Vendeur")
  departement    String? // Département (ex: "Ventes", "Comptabilité")
  dateEmbauche   DateTime? @db.Date
  dateFinContrat DateTime? @db.Date // Pour CDD
  salaireHoraire Decimal?  @db.Decimal(10, 2) // Pour calcul des commissions
  numeroSecu     String? // Numéro de sécurité sociale
  iban           String? // Pour virements salaire

  // Permissions détaillées
  permissions UserPermissions?

  // Horaires et planning
  schedules UserSchedule[]

  // Tracking temps de travail
  timeEntries TimeEntry[]

  // Activité
  lastLoginAt    DateTime?
  lastActivityAt DateTime?

  // Onboarding: tracking si l'utilisateur a complété son profil
  onboardingComplete Boolean @default(false)

  // Préférences de notifications
  emailNotifications Boolean @default(true) // Notifications importantes par email
  newsUpdates        Boolean @default(false) // Actualités et mises à jour

  // Relations
  conversations        Conversation[]
  mouvementsStock      MouvementStock[]         @relation("UserStockMovements")
  activitiesCreated    UserActivity[]           @relation("CreatedActivities")
  reparationsAssignees Reparation[]             @relation("ReparationTechnicien")
  interventions        ReparationIntervention[] @relation("InterventionTechnicien")
  employee             Employee? // Lien optionnel avec le profil employé

  // Relations pour système plomberie/chauffage
  interventionsPlombier Intervention[]        @relation("InterventionPlombier")
  interventionsTime     InterventionTimeLog[] @relation("InterventionPlombierTime")
  camionnettes          Camionnette[] // Camionnettes dont ce user est plombier principal
  entretiensAssignes    EntretienPrevu[]
  certificatsRealises   CertificatEntretien[] // Certificats réalisés par ce technicien

  // Relations pour système consulting / services intellectuels
  entreesTemps EntreeTemps[] // Entrées de temps sur missions

  // Relations pour système juridique (cabinets d'avocats)
  diligences Diligence[] // Diligences effectuées par cet avocat

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([entrepriseId, status])
  @@index([entrepriseId, role])
}

// Permissions granulaires par utilisateur
model UserPermissions {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Permissions Clients
  canViewClients   Boolean @default(false)
  canCreateClients Boolean @default(false)
  canEditClients   Boolean @default(false)
  canDeleteClients Boolean @default(false)

  // Permissions Documents (Devis, Factures)
  canViewDocuments     Boolean @default(false)
  canCreateDocuments   Boolean @default(false)
  canEditDocuments     Boolean @default(false)
  canDeleteDocuments   Boolean @default(false)
  canValidateDocuments Boolean @default(false) // Valider/Accepter devis

  // Permissions Stock
  canViewStock   Boolean @default(false)
  canEditStock   Boolean @default(false)
  canManageStock Boolean @default(false) // Mouvements stock

  // Permissions Produits/Services
  canViewProducts   Boolean @default(false)
  canCreateProducts Boolean @default(false)
  canEditProducts   Boolean @default(false)
  canDeleteProducts Boolean @default(false)

  // Permissions Finances
  canViewFinances   Boolean @default(false)
  canManagePayments Boolean @default(false)
  canViewReports    Boolean @default(false)
  canExportData     Boolean @default(false)

  // Permissions Personnel
  canViewUsers        Boolean @default(false)
  canManageUsers      Boolean @default(false) // Créer/Modifier users
  canViewTimeTracking Boolean @default(false)

  // Permissions Paramètres
  canViewSettings Boolean @default(false)
  canEditSettings Boolean @default(false)

  // Permissions Avancées
  canAccessAPI     Boolean @default(false)
  canManageBilling Boolean @default(false) // Gérer abonnement
  canViewAuditLog  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Horaires de travail (planning)
model UserSchedule {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Jour de la semaine (0 = Dimanche, 1 = Lundi, ..., 6 = Samedi)
  dayOfWeek Int

  // Heures de travail
  startTime String // Format "HH:mm" (ex: "09:00")
  endTime   String // Format "HH:mm" (ex: "18:00")

  // Pause déjeuner
  breakStart String? // Format "HH:mm"
  breakEnd   String? // Format "HH:mm"

  // Actif ou non (pour gérer les exceptions)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOfWeek])
  @@index([userId])
  @@index([dayOfWeek])
}

// Suivi du temps de travail (pointage)
model TimeEntry {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Date et heures
  date     DateTime  @db.Date
  clockIn  DateTime // Heure d'arrivée
  clockOut DateTime? // Heure de départ (null si en cours)

  // Pause
  breakDuration Int @default(0) // Durée de pause en minutes

  // Heures travaillées (calculé automatiquement)
  hoursWorked Decimal? @db.Decimal(5, 2) // Ex: 8.50 heures

  // Notes
  notes String?

  // Type de journée
  type TimeEntryType @default(REGULAR)

  // Validation
  validated   Boolean   @default(false)
  validatedBy String? // ID du manager qui a validé
  validatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@index([validated])
}

enum TimeEntryType {
  REGULAR // Journée normale
  OVERTIME // Heures supplémentaires
  SICK_LEAVE // Arrêt maladie
  VACATION // Congés
  REMOTE // Télétravail
}

// Log d'activité utilisateur
model UserActivity {
  id         String       @id @default(cuid())
  user       User         @relation("CreatedActivities", fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  action     ActivityType
  resource   String? // Type de ressource (ex: "Client", "Document", "Article")
  resourceId String? // ID de la ressource
  details    Json? // Détails additionnels
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
}

enum ActivityType {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  PRINT
  SEND_EMAIL
  PAYMENT_RECEIVED
  SETTINGS_CHANGED
}

// ============================================
// CLIENTS
// ============================================

model Client {
  id         String  @id @default(cuid())
  nom        String
  prenom     String?
  email      String?
  telephone  String?
  adresse    String?
  codePostal String?
  ville      String?
  pays       String  @default("France")
  notes      String?

  // Authentification portail client
  password            String? // Hashed password for client portal access
  clientPortalEnabled Boolean   @default(false) // Enable/disable portal access
  pendingApproval     Boolean   @default(false) // Client waiting for admin approval after self-registration
  lastLoginAt         DateTime? // Track last portal login

  // Programme de fidélité
  points_solde     Int             @default(0)
  niveauFidelite   NiveauFidelite? @relation(fields: [niveauFideliteId], references: [id])
  niveauFideliteId String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  documents        Document[]
  mouvementsPoints MouvementPoints[]
  notifications    ClientNotification[]

  // Relation pour système d'occasion (boutiques informatique)
  rachats     RachatArticle[] // Articles rachetés à ce client
  reparations Reparation[] // Réparations pour ce client

  // Relations pour système plomberie/chauffage
  interventions     Intervention[] // Interventions pour ce client
  contratsEntretien ContratEntretien[] // Contrats d'entretien
  equipements       EquipementClient[] // Parc équipements installés

  // Relations pour système restauration
  reservations Reservation[] // Réservations au restaurant

  // Relations pour système coiffure / rendez-vous
  rendezVous RendezVous[] // Rendez-vous chez le prestataire

  // Relations pour système fitness
  abonnementsFitness AbonnementFitness[] // Abonnements salle de sport
  reservationsCours  ReservationCours[] // Réservations aux cours collectifs
  presencesFitness   PresenceFitness[] // Historique des check-ins

  // Relations pour système consulting / services intellectuels
  missions Mission[] // Missions de consulting

  // Relations pour système comptabilité
  echeancesFiscales EcheanceFiscale[] // Échéances fiscales

  // Relations pour système juridique (cabinets d'avocats)
  affaires Affaire[] // Affaires juridiques

  // Informations fiscales du client (pour cabinets comptables)
  siret               String? // Numéro SIRET
  formeJuridique      FormeJuridique? // Forme juridique (SARL, SAS, etc.)
  regimeFiscal        RegimeFiscal? // Régime fiscal (réel normal, simplifié, micro)
  regimeTVA           RegimeTVA? // Régime de TVA
  typeImposition      TypeImposition? // Type d'imposition (IS ou IR)
  dateClotureExercice String? // Date de clôture (format "MM-DD", ex: "12-31")
  avecSalaries        Boolean? // Le client a-t-il des salariés ?
  effectif            Int? // Nombre de salariés
  codeAPE             String? // Code APE/NAF
  numTVAIntra         String? // Numéro de TVA intracommunautaire

  // Relations pour système immobilier
  biensProprietaire      BienImmobilier[]        @relation("BiensProprietaire")
  mandatsClient          MandatImmobilier[]      @relation("MandatsClient")
  visitesAcquereur       VisiteImmobilier[]      @relation("VisitesAcquereur")
  offresAcquereur        OffreAchat[]            @relation("OffresAcquereur")
  recherchesAcquereur    RechercheAcquereur[]    @relation("RecherchesAcquereur")
  leadsConvertis         LeadPortail[]           @relation("LeadsConvertis")
  bauxLocataire          BailLocatif[]           @relation("BauxLocataire")
  bauxProprietaire       BailLocatif[]           @relation("BauxProprietaire")
  lotsCoproprietaire     LotCopropriete[]        @relation("LotsCoproprietaire")
  lotsLocataire          LotCopropriete[]        @relation("LotsLocataire")
  membresConseilSyndical MembreConseilSyndical[] @relation("MembresConseilSyndical")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([nom])
  @@index([email])
  @@index([ville])
  @@index([niveauFideliteId])
  @@index([points_solde])
  @@index([clientPortalEnabled])
  @@index([pendingApproval])
  @@index([entrepriseId, pendingApproval])
  @@index([entrepriseId, niveauFideliteId])
  @@index([telephone])
  @@index([siret])
}

// Tokens de réinitialisation de mot de passe pour le portail client
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  clientId  String
  email     String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([token])
  @@index([clientId])
  @@index([email])
  @@index([expiresAt])
}

// Tokens d'invitation pour créer un compte portail client
model InvitationToken {
  id           String    @id @default(cuid())
  token        String    @unique
  email        String
  nom          String?
  prenom       String?
  telephone    String?
  entrepriseId String
  expiresAt    DateTime
  used         Boolean   @default(false)
  usedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@index([entrepriseId])
  @@index([expiresAt])
}

// Tokens d'invitation pour les collaborateurs (équipe)
model UserInvitationToken {
  id           String    @id @default(cuid())
  token        String    @unique
  email        String
  name         String?
  prenom       String?
  role         String // UserRole as string
  entrepriseId String
  invitedBy    String // User ID qui a envoyé l'invitation
  expiresAt    DateTime
  used         Boolean   @default(false)
  usedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@index([entrepriseId])
  @@index([expiresAt])
  @@index([used])
}

// Notifications pour le portail client
model ClientNotification {
  id       String           @id @default(cuid())
  type     NotificationType
  titre    String
  message  String?
  lue      Boolean          @default(false)
  metadata Json? // Données additionnelles (documentId, points, etc.)

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  createdAt DateTime  @default(now())
  lueAt     DateTime?

  @@index([clientId])
  @@index([lue])
  @@index([createdAt])
  @@index([clientId, lue])
}

enum NotificationType {
  NOUVEAU_DOCUMENT
  POINTS_EXPIRATION
  NIVEAU_FIDELITE
  PAIEMENT_RECU
  GENERAL
  REPARATION_DEPOSEE
  REPARATION_DIAGNOSTIC
  REPARATION_PRETE
  REPARATION_RETARD
  REPARATION_LIVREE
}

// ============================================
// CATALOGUE
// ============================================

model Categorie {
  id          String  @id @default(cuid())
  nom         String
  description String?
  ordre       Int     @default(0)
  parentId    String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  parent       Categorie?          @relation("CategoriesToParent", fields: [parentId], references: [id])
  enfants      Categorie[]         @relation("CategoriesToParent")
  articles     Article[]
  champsCustom ChampPersonnalise[]

  createdAt DateTime @default(now())

  @@index([entrepriseId])
  @@index([nom])
  @@index([ordre])
}

model ChampPersonnalise {
  id          String          @id @default(cuid())
  categorieId String
  nom         String
  code        String
  type        TypeChampCustom @default(TEXT)
  ordre       Int             @default(0)
  obligatoire Boolean         @default(false)
  placeholder String?
  description String?
  options     Json?
  validation  Json?

  categorie Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categorieId, code])
  @@index([categorieId])
  @@index([ordre])
}

enum TypeChampCustom {
  TEXT
  TEXTAREA
  NUMBER
  DECIMAL
  SELECT
  MULTISELECT
  CHECKBOX
  DATE
  COLOR
  URL
  EMAIL
}

model Article {
  id            String      @id @default(cuid())
  reference     String
  nom           String
  description   String?
  type          ArticleType @default(PRODUIT)
  prix_ht       Decimal     @db.Decimal(10, 2)
  tva_taux      Decimal     @default(20.00) @db.Decimal(5, 2)
  unite         String      @default("unité")
  stock_actuel  Int         @default(0)
  stock_min     Int         @default(0)
  gestion_stock Boolean     @default(false)
  actif         Boolean     @default(true)
  champsCustom  Json?

  // Champs spécifiques pour type PIECE (pièces détachées)
  typePiece        TypeRessource? // Type de pièce (ECRAN, BATTERIE, etc.)
  etatPiece        EtatOccasion? // État de la pièce (COMME_NEUF, BON, etc.)
  marque           String? // Compatibilité marque
  modele           String? // Compatibilité modèle
  articleOrigineId String? // Article source si issu d'un démontage
  valeurEstimee    Decimal?       @db.Decimal(10, 2) // Valeur estimée pour calcul marge

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  categorie       Categorie?          @relation(fields: [categorieId], references: [id])
  categorieId     String?
  lignes          LigneDocument[]
  mouvements      MouvementStock[]
  storeStockItems StoreStockItem[] // Stock par magasin
  transferItems   StockTransferItem[] // Items dans les transferts

  // Relations pour les articles d'occasion
  rachat           RachatArticle? // Si type=OCCASION, lien vers les infos de rachat
  demontage        DemontageArticle?  @relation("ArticleDemonte") // Si démonté
  piecesRecuperees RessourceAtelier[] @relation("PieceOrigine") // Pièces récupérées de cet article

  // Relations pour les pièces détachées (type PIECE)
  articleOrigine   Article?               @relation("PiecesDetachees", fields: [articleOrigineId], references: [id], onDelete: SetNull)
  piecesDetachees  Article[]              @relation("PiecesDetachees") // Pièces issues du démontage de cet article
  lignesReparation ReparationLignePiece[] // Utilisations dans des réparations

  // Relations pour système plomberie
  interventionsMateriel InterventionMateriel[] // Matériel utilisé dans interventions
  stockCamionnettes     StockCamionnette[] // Stock dans les camionnettes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, reference])
  @@index([entrepriseId])
  @@index([reference])
  @@index([nom])
  @@index([type])
  @@index([categorieId])
  @@index([actif])
  @@index([entrepriseId, actif])
  @@index([categorieId, actif])
  @@index([typePiece])
  @@index([marque])
  @@index([modele])
  @@index([articleOrigineId])
}

enum ArticleType {
  PRODUIT
  SERVICE
  OCCASION
  PIECE
}

// ============================================
// SYSTÈME D'OCCASION (BOUTIQUES INFORMATIQUE)
// ============================================

enum EtatOccasion {
  COMME_NEUF
  TRES_BON
  BON
  CORRECT
  POUR_PIECES
}

enum ProvenanceOccasion {
  RACHAT_CLIENT
  MARKETPLACE_OCCASION
  REPRISE
  DON
  RETOUR_SAV
  AUTRE
}

enum TypeRessource {
  ECRAN
  BATTERIE
  CARTE_MERE
  CAMERA
  HAUT_PARLEUR
  CONNECTEUR_CHARGE
  VITRE
  CHASSIS
  MEMOIRE_RAM
  DISQUE_DUR
  ALIMENTATION
  VENTILATEUR
  CLAVIER
  TRACKPAD
  AUTRE
}

// Model pour tracer les rachats d'articles d'occasion
model RachatArticle {
  id            String             @id @default(cuid())
  articleId     String             @unique
  clientId      String?
  prixRachat    Decimal            @db.Decimal(10, 2)
  etat          EtatOccasion
  provenance    ProvenanceOccasion
  numeroSerie   String?
  dureeGarantie Int? // Durée en mois (3, 6, 12, 24)
  notes         String?
  dateRachat    DateTime           @default(now())

  // Relations
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  client       Client?    @relation(fields: [clientId], references: [id])
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([clientId])
  @@index([dateRachat])
}

// Model pour tracer les démontages d'articles d'occasion
model DemontageArticle {
  id              String   @id @default(cuid())
  articleSourceId String   @unique
  dateDemontage   DateTime @default(now())
  motif           String?
  notes           String?

  // Relations
  articleSource Article            @relation("ArticleDemonte", fields: [articleSourceId], references: [id], onDelete: Cascade)
  ressources    RessourceAtelier[]

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  createdBy    String?
  createdAt    DateTime   @default(now())

  @@index([entrepriseId])
  @@index([articleSourceId])
}

// Model pour les ressources d'atelier (pièces récupérées)
model RessourceAtelier {
  id String @id @default(cuid())

  // Type et description
  typeRessource TypeRessource
  nom           String
  description   String?
  etat          EtatOccasion

  // Stock
  quantite Int    @default(1)
  unite    String @default("unité")

  // Provenance
  demontageId      String?
  demontage        DemontageArticle? @relation(fields: [demontageId], references: [id])
  articleOrigineId String?
  articleOrigine   Article?          @relation("PieceOrigine", fields: [articleOrigineId], references: [id])

  // Compatibilité (pour recherche)
  marque    String?
  modele    String?
  reference String?

  // Utilisation
  utiliseDansReparation Boolean   @default(false)
  dateUtilisation       DateTime?
  reparationId          String?

  // Valeur (pour calcul marge)
  valeurEstimee Decimal? @db.Decimal(10, 2)

  // Multi-tenant
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  // Relations
  lignesReparation ReparationLignePiece[] // Utilisations dans des réparations

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([typeRessource])
  @@index([nom])
  @@index([marque])
  @@index([modele])
  @@index([demontageId])
  @@index([utiliseDansReparation])
}

// ============================================
// TRANSACTIONS
// ============================================

model Document {
  id           String         @id @default(cuid())
  numero       String
  type         DocumentType
  dateEmission DateTime       @db.Date
  dateEcheance DateTime?      @db.Date
  statut       DocumentStatut @default(BROUILLON)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  // Série de numérotation (optionnel pour rétrocompatibilité)
  serie   SerieDocument? @relation(fields: [serieId], references: [id])
  serieId String?

  // Multi-magasins
  store   Store?  @relation(fields: [storeId], references: [id])
  storeId String? // Magasin où le document a été créé

  register   Register? @relation(fields: [registerId], references: [id])
  registerId String? // Caisse où le document a été créé

  total_ht  Decimal @default(0) @db.Decimal(10, 2)
  total_tva Decimal @default(0) @db.Decimal(10, 2)
  total_ttc Decimal @default(0) @db.Decimal(10, 2)

  acompte_montant Decimal @default(0) @db.Decimal(10, 2)
  reste_a_payer   Decimal @default(0) @db.Decimal(10, 2)

  notes               String?
  conditions_paiement String?
  validite_jours      Int     @default(30)

  devisId  String?
  devis    Document?  @relation("DevisToFacture", fields: [devisId], references: [id])
  factures Document[] @relation("DevisToFacture")

  lignes           LigneDocument[]
  paiements        Paiement[]
  bankTransactions BankTransaction[] // Transactions bancaires rapprochées
  reparations      Reparation[] // Réparations liées à ce document
  interventions    Intervention[]    @relation("InterventionDocument") // Interventions plomberie liées

  // Relations pour système consulting / services intellectuels
  missionsDevis    Mission[] @relation("MissionDevis") // Missions créées depuis ce devis
  missionsFactures Mission[] @relation("MissionFactures") // Missions facturées via ce document

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([numero])
  @@index([type])
  @@index([clientId])
  @@index([serieId])
  @@index([statut])
  @@index([dateEmission])
  @@index([dateEcheance])
  @@index([entrepriseId, statut]) // Index composite pour requêtes par entreprise + statut
  @@index([entrepriseId, type])
  @@index([clientId, statut])
}

enum DocumentType {
  DEVIS
  FACTURE
  AVOIR
}

enum DocumentStatut {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  PAYE
  ANNULE
}

model LigneDocument {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  article    Article? @relation(fields: [articleId], references: [id])
  articleId  String?

  ordre            Int
  designation      String
  description      String?
  quantite         Decimal @db.Decimal(10, 2)
  prix_unitaire_ht Decimal @db.Decimal(10, 2)
  tva_taux         Decimal @db.Decimal(5, 2)
  remise_pourcent  Decimal @default(0) @db.Decimal(5, 2)

  montant_ht  Decimal @db.Decimal(10, 2)
  montant_tva Decimal @db.Decimal(10, 2)
  montant_ttc Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([articleId])
  @@index([ordre])
  @@index([documentId, articleId])
}

model Paiement {
  id             String        @id @default(cuid())
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentId     String
  date_paiement  DateTime      @db.Date
  montant        Decimal       @db.Decimal(10, 2)
  moyen_paiement MoyenPaiement
  reference      String?
  notes          String?

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([date_paiement])
  @@index([moyen_paiement])
}

enum MoyenPaiement {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  PRELEVEMENT
}

// ============================================
// GESTION DES STOCKS
// ============================================

model MouvementStock {
  id          String        @id @default(cuid())
  type        TypeMouvement
  quantite    Int
  stock_avant Int
  stock_apres Int
  motif       String?
  reference   String?
  notes       String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  // Multi-magasins
  store   Store?  @relation(fields: [storeId], references: [id])
  storeId String? // Magasin concerné par le mouvement

  // Tracking utilisateur qui a créé le mouvement
  createdByUser User?   @relation("UserStockMovements", fields: [createdBy], references: [id])
  createdBy     String?

  createdAt DateTime @default(now())

  @@index([entrepriseId])
  @@index([articleId])
  @@index([storeId])
  @@index([type])
  @@index([createdAt])
  @@index([createdBy])
  @@index([articleId, createdAt])
  @@index([entrepriseId, createdAt])
}

enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
  INVENTAIRE
  RETOUR
}

// ============================================
// PARAMÈTRES ENTREPRISE
// ============================================

model ParametresEntreprise {
  id             String  @id @default(cuid())
  nom_entreprise String
  siret          String?
  tva_intra      String?
  adresse        String?
  code_postal    String?
  ville          String?
  telephone      String?
  email          String?
  site_web       String?
  logo_url       String?

  prefixe_devis           String @default("DEV")
  prefixe_facture         String @default("FACT")
  prochain_numero_devis   Int    @default(1)
  prochain_numero_facture Int    @default(1)

  // Configuration références articles/services
  prefixe_produit          String @default("PRD")
  prefixe_service          String @default("SRV")
  prefixe_occasion         String @default("OCC")
  prefixe_piece            String @default("PCE")
  prochain_numero_produit  Int    @default(1)
  prochain_numero_service  Int    @default(1)
  prochain_numero_occasion Int    @default(1)
  prochain_numero_piece    Int    @default(1)

  // Configuration références réparations (boutiques informatique)
  prefixe_reparation         String @default("REP")
  prochain_numero_reparation Int    @default(1)

  conditions_paiement_defaut String?
  mentions_legales           String?

  // Préférences de notification
  notif_client_approved   Boolean @default(true) // Envoyer email quand client approuvé
  notif_client_rejected   Boolean @default(true) // Envoyer email quand client rejeté
  notif_client_invitation Boolean @default(true) // Envoyer email d'invitation
  notif_client_welcome    Boolean @default(true) // Envoyer email de bienvenue
  notif_document_sent     Boolean @default(true) // Envoyer email quand document envoyé
  notif_payment_received  Boolean @default(true) // Envoyer email quand paiement reçu
  notif_low_stock         Boolean @default(true) // Envoyer email si stock faible

  // Multi-tenant: relation one-to-one
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
}

// Séries de numérotation personnalisées pour les documents
model SerieDocument {
  id          String  @id @default(cuid())
  code        String // "ART", "SER", "CONS", etc.
  nom         String // "Vente de produits", "Prestations", etc.
  description String?
  couleur     String? @default("#000000") // Couleur pour l'UI

  // Types de documents supportés par cette série
  pour_devis    Boolean @default(true)
  pour_factures Boolean @default(true)
  pour_avoirs   Boolean @default(false)

  // Numérotation indépendante
  prochain_numero Int       @default(1)
  format_numero   String    @default("{CODE}{NUM5}") // Variables: {CODE}, {NUM5}, {YEAR}, {MONTH}, {TYPE}
  reset_compteur  String    @default("AUCUN") // "AUCUN", "ANNUEL", "MENSUEL"
  derniere_reset  DateTime? // Date du dernier reset (pour tracking)

  // Configuration - Séries par défaut par type
  est_defaut_devis    Boolean @default(false) // Série par défaut pour les devis
  est_defaut_factures Boolean @default(false) // Série par défaut pour les factures
  est_defaut_avoirs   Boolean @default(false) // Série par défaut pour les avoirs
  active              Boolean @default(true)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, code])
  @@index([entrepriseId])
  @@index([entrepriseId, est_defaut_devis])
  @@index([entrepriseId, est_defaut_factures])
  @@index([entrepriseId, est_defaut_avoirs])
  @@index([active])
}

// ============================================
// PROGRAMME DE FIDÉLITÉ
// ============================================

model NiveauFidelite {
  id          String  @id @default(cuid())
  nom         String
  description String?
  ordre       Int     @default(0)
  seuilPoints Int
  remise      Decimal @default(0) @db.Decimal(5, 2)
  couleur     String  @default("#000000")
  icone       String?
  avantages   String?
  actif       Boolean @default(true)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  clients Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, nom])
  @@unique([entrepriseId, ordre])
  @@index([entrepriseId])
  @@index([ordre])
  @@index([seuilPoints])
  @@index([actif])
}

model MouvementPoints {
  id             String              @id @default(cuid())
  type           TypeMouvementPoints
  points         Int
  description    String?
  reference      String?
  dateExpiration DateTime?           @db.Date

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  createdAt DateTime @default(now())

  @@index([entrepriseId])
  @@index([clientId])
  @@index([type])
  @@index([createdAt])
  @@index([dateExpiration])
}

enum TypeMouvementPoints {
  GAIN
  DEPENSE
  EXPIRATION
  AJUSTEMENT
}

// ============================================
// SEGMENTATION CLIENTS
// ============================================

model Segment {
  id          String      @id @default(cuid())
  nom         String
  description String?
  type        TypeSegment @default(CUSTOM)
  icone       String? // Nom de l'icône lucide-react (ex: "Users", "Mail", "MapPin")
  couleur     String? // Couleur de fond (ex: "#f3f4f6")

  // Critères de filtrage stockés en JSON
  // Format pour segments prédéfinis: { type: "all" } ou { type: "with-email" }
  // Format pour segments custom: [
  //   { field: "email", operator: "exists" },
  //   { field: "points_solde", operator: "gt", value: 100 }
  // ]
  criteres Json

  // Statistiques (cache, recalculées périodiquement)
  derniereCalcul DateTime?
  nombreClients  Int?      @default(0)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  campaigns Campaign[]

  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, nom])
  @@index([entrepriseId])
  @@index([type])
  @@index([actif])
}

enum TypeSegment {
  PREDEFINED // Segments système (tous clients, avec email, etc.)
  CUSTOM // Segments créés par l'utilisateur
}

// ============================================
// AUTOMATIONS
// ============================================

model Automation {
  id          String  @id @default(cuid())
  nom         String
  description String?
  actif       Boolean @default(true)

  // Trigger
  triggerType   TriggerType
  triggerConfig Json // Configuration du trigger

  // Action
  actionType   ActionType
  actionConfig Json // Configuration de l'action

  // Statistiques
  derniereExecution DateTime?
  nombreExecutions  Int       @default(0)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  executions AutomationExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([actif])
  @@index([triggerType])
}

enum TriggerType {
  NEW_CLIENT_IN_SEGMENT
  CLIENT_MILESTONE
  SEGMENT_CHANGE
  INACTIVITY
  SCHEDULED
}

enum ActionType {
  SEND_EMAIL
  ADD_TO_SEGMENT
  REMOVE_FROM_SEGMENT
  ADD_POINTS
  SEND_SMS
  CREATE_TASK
}

model AutomationExecution {
  id           String     @id @default(cuid())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String

  clientId String?
  statut   ExecutionStatut
  resultat String?
  erreur   String?

  executedAt DateTime @default(now())

  @@index([automationId])
  @@index([statut])
  @@index([executedAt])
}

enum ExecutionStatut {
  SUCCESS
  FAILED
  PENDING
}

// ============================================
// CAMPAGNES
// ============================================

model Campaign {
  id          String         @id @default(cuid())
  nom         String
  description String?
  type        CampaignType   @default(EMAIL)
  statut      CampaignStatut @default(DRAFT)

  segment   Segment? @relation(fields: [segmentId], references: [id])
  segmentId String?
  subject   String?
  body      String?

  scheduledAt DateTime?
  sentAt      DateTime?

