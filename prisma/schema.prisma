  @@index([entrepriseId])
  @@index([statut])
  @@index([scheduledAt])
}

enum CampaignType {
  EMAIL
  SMS
  NOTIFICATION
}

enum CampaignStatut {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

// ============================================
// CHATBOT IA
// ============================================

model Conversation {
  id     String  @id @default(cuid())
  titre  String // Auto-généré à partir du premier message
  pinned Boolean @default(false) // Conversations épinglées

  // Multi-tenant
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([entrepriseId])
  @@index([createdAt])
  @@index([pinned])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  role    MessageRole // "user" | "assistant" | "system"
  content String      @db.Text

  // Tracking du modèle IA utilisé (pour analytics)
  model String? // "gpt-4o-mini" | "gpt-4o" | null (si user message)

  // Métadonnées JSON pour:
  // - Actions exécutées (function calling results)
  // - Feedback utilisateur (thumbs up/down)
  // - Tokens utilisés (input/output)
  // - Temps de réponse
  metadata Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ============================================
// LIENS DE PAIEMENT (PAYMENT LINKS)
// ============================================

model PaymentLink {
  id          String  @id @default(cuid())
  slug        String  @unique // URL-friendly slug (ex: "facture-mars-2025")
  titre       String // Titre du lien (ex: "Facture Mars 2025")
  description String? // Description optionnelle

  montant Decimal @db.Decimal(10, 2)
  devise  String  @default("EUR")

  // Options
  quantiteMax    Int?      @default(1) // Nombre de paiements max (null = illimité)
  quantitePaye   Int       @default(0) // Nombre de paiements effectués
  dateExpiration DateTime? // Date d'expiration du lien
  actif          Boolean   @default(true)

  // Personnalisation
  imageCouverture String? // URL de l'image de couverture
  messageSucces   String? // Message affiché après paiement

  // Métadonnées
  metadata Json? // Données additionnelles (référence commande, etc.)

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Statistiques
  nombreVues      Int     @default(0) // Nombre de fois que le lien a été consulté
  nombrePaiements Int     @default(0) // Nombre de paiements réussis
  totalCollecte   Decimal @default(0) @db.Decimal(10, 2) // Montant total collecté

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([slug])
  @@index([actif])
  @@index([dateExpiration])
}

enum PaymentLinkStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  DISABLED
}

// ============================================
// STRIPE TERMINAL (TPE PHYSIQUES)
// ============================================

model Terminal {
  id               String         @id @default(cuid())
  stripeTerminalId String         @unique // ID du terminal dans Stripe
  label            String // Nom du terminal (ex: "Caisse 1")
  location         String? // Emplacement physique
  status           TerminalStatus @default(OFFLINE)

  // Informations matériel
  device_type   String? // Type de terminal (bbpos_wisepad3, verifone_p400, etc.)
  serial_number String?
  ip_address    String?

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Dernière activité
  lastUsedAt DateTime?
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([status])
  @@index([stripeTerminalId])
}

enum TerminalStatus {
  ONLINE
  OFFLINE
  BUSY
  ERROR
}

// ============================================
// RAPPROCHEMENT BANCAIRE
// ============================================

model BankTransaction {
  id String @id @default(cuid())

  // Informations transaction bancaire
  date      DateTime @db.Date
  libelle   String // Libellé de la transaction
  montant   Decimal  @db.Decimal(10, 2)
  reference String? // Référence bancaire

  // Rapprochement
  statut     ReconciliationStatus @default(PENDING)
  documentId String? // Document associé (si trouvé)
  document   Document?            @relation(fields: [documentId], references: [id])

  // Notes et métadonnées
  notes    String?
  metadata Json? // Infos additionnelles du relevé bancaire

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([statut])
  @@index([date])
  @@index([documentId])
}

enum ReconciliationStatus {
  PENDING // En attente de rapprochement
  MATCHED // Rapproché automatiquement
  MANUAL // Rapproché manuellement
  IGNORED // Ignoré
  ANOMALY // Anomalie détectée
}

// ============================================
// SYSTÈME DE RÉPARATION (BOUTIQUES INFORMATIQUE)
// ============================================

enum StatutReparation {
  DEPOSE // Appareil déposé, en attente de diagnostic
  DIAGNOSTIC // En cours de diagnostic
  DEVIS_ENVOYE // Devis envoyé au client
  ATTENTE_PIECES // En attente de pièces
  EN_COURS // Réparation en cours
  PRETE // Prête à être récupérée
  LIVREE // Livrée au client
  ANNULEE // Annulée
  ABANDONNEE // Abandonnée (client n'est pas venu)
}

enum PrioriteReparation {
  NORMALE
  URGENTE
  CRITIQUE
}

enum TypeAppareil {
  PC_PORTABLE
  PC_BUREAU
  MAC
  SMARTPHONE
  TABLETTE
  CONSOLE_JEU
  SERVEUR
  PERIPHERIQUE
  AUTRE
}

model Reparation {
  id        String  @id @default(cuid())
  numero    String  @unique // REP-001, REP-002, etc.
  reference String? // Référence client optionnelle

  // Client information
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  // Device information
  typeAppareil        TypeAppareil
  marque              String? // Brand (Apple, Dell, HP, etc.)
  modele              String? // Model
  numeroSerie         String? // Serial number
  motAuthentification String?      @db.Text // Device password/PIN if needed

  // Reported issue
  panne       String  @db.Text // Customer complaint/issue description
  etatVisuel  String? @db.Text // Visual condition notes
  accessoires String? @db.Text // Included accessories (charger, case, etc.)

  // Diagnostic
  diagnosticEffectue Boolean   @default(false)
  diagnosticDetail   String?   @db.Text
  diagnosticDate     DateTime?
  diagnosticParId    String? // User ID who performed diagnostic

  // Priority and deadlines
  priorite          PrioriteReparation @default(NORMALE)
  dateDepot         DateTime           @default(now())
  dateEstimeeRetour DateTime?
  dateRetourReel    DateTime?
  delaiReparation   Int? // Estimated repair time in hours

  // Status and workflow
  statut           StatutReparation @default(DEPOSE)
  statutChangeLogs Json? // History of status changes [{statut, date, userId}]

  // Technician assignment
  technicien   User?   @relation("ReparationTechnicien", fields: [technicienId], references: [id])
  technicienId String?

  // Store/Register
  store   Store?  @relation(fields: [storeId], references: [id])
  storeId String? // Store where repair was received

  register   Register? @relation(fields: [registerId], references: [id])
  registerId String? // Register where repair was created

  // Costs and billing
  devisEstime Decimal @default(0) @db.Decimal(10, 2) // Estimated cost
  coutMain    Decimal @default(0) @db.Decimal(10, 2) // Labor cost
  coutPieces  Decimal @default(0) @db.Decimal(10, 2) // Parts cost (auto-calculated)
  coutTotal   Decimal @default(0) @db.Decimal(10, 2) // Total cost

  // Linked document (quote or invoice)
  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?

  // Internal notes
  notesInternes   String? @db.Text
  notesTechnicien String? @db.Text

  // Warranty
  sousGarantie    Boolean   @default(false)
  dateFinGarantie DateTime? // Warranty end date after repair

  // Notifications sent
  notificationsEnvoyees Json? // Track which notifications were sent

  // Multi-tenant
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Relations
  lignesPieces  ReparationLignePiece[] // Parts used
  interventions ReparationIntervention[] // Intervention logs
  photos        ReparationPhoto[] // Photos (optional)
  historique    ReparationHistorique[] // Complete history log

  createdBy String? // User ID who created the repair ticket
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId])
  @@index([clientId])
  @@index([statut])
  @@index([technicienId])
  @@index([storeId])
  @@index([dateDepot])
  @@index([dateEstimeeRetour])
  @@index([entrepriseId, statut])
  @@index([entrepriseId, dateDepot])
  @@index([priorite])
}

// Parts/pieces used in repair
model ReparationLignePiece {
  id String @id @default(cuid())

  reparation   Reparation @relation(fields: [reparationId], references: [id], onDelete: Cascade)
  reparationId String

  // Link to article (could be Article or RessourceAtelier)
  article   Article? @relation(fields: [articleId], references: [id])
  articleId String?

  ressourceAtelier   RessourceAtelier? @relation(fields: [ressourceAtelierId], references: [id])
  ressourceAtelierId String?

  designation  String
  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)
  montant      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([reparationId])
  @@index([articleId])
  @@index([ressourceAtelierId])
}

// Intervention logs (time tracking for technicians)
model ReparationIntervention {
  id String @id @default(cuid())

  reparation   Reparation @relation(fields: [reparationId], references: [id], onDelete: Cascade)
  reparationId String

  technicien   User   @relation("InterventionTechnicien", fields: [technicienId], references: [id])
  technicienId String

  dateDebut    DateTime
  dateFin      DateTime?
  dureeMinutes Int? // Auto-calculated duration

  description String @db.Text
  type        String @default("REPARATION") // DIAGNOSTIC, REPARATION, TEST, NETTOYAGE

  createdAt DateTime @default(now())

  @@index([reparationId])
  @@index([technicienId])
  @@index([dateDebut])
}

// Photos attached to repair (optional feature)
model ReparationPhoto {
  id String @id @default(cuid())

  reparation   Reparation @relation(fields: [reparationId], references: [id], onDelete: Cascade)
  reparationId String

  url     String
  legende String?
  type    String  @default("AVANT") // AVANT, APRES, DIAGNOSTIC, PIECE_DEFECTUEUSE
  ordre   Int     @default(0)

  uploadedBy String? // User ID
  createdAt  DateTime @default(now())

  @@index([reparationId])
  @@index([type])
}

// Complete history log for auditing
model ReparationHistorique {
  id String @id @default(cuid())

  reparation   Reparation @relation(fields: [reparationId], references: [id], onDelete: Cascade)
  reparationId String

  action      String // "STATUS_CHANGE", "PIECE_ADDED", "NOTE_ADDED", "ASSIGNED", etc.
  description String @db.Text
  metadata    Json? // Additional data (old/new values)

  createdBy String? // User ID
  createdAt DateTime @default(now())

  @@index([reparationId])
  @@index([createdAt])
  @@index([action])
}

// ============================================
// GESTION DU PERSONNEL
// ============================================

enum StatutEmploye {
  ACTIF
  CONGE
  MALADIE
  ABSENT
  INACTIF
}

enum TypeContrat {
  CDI
  CDD
  INTERIM
  APPRENTI
  STAGE
  FREELANCE
}

model Employee {
  id String @id @default(cuid())

  // Relation avec l'entreprise
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  // Informations personnelles
  prenom        String
  nom           String
  email         String
  telephone     String?
  dateNaissance DateTime?
  adresse       String?
  ville         String?
  codePostal    String?
  pays          String?   @default("France")

  // Photo de profil
  photoUrl String?

  // Informations professionnelles
  poste       String // Titre du poste (ex: Technicien, Vendeur, Manager)
  departement String? // Département ou service
  statut      StatutEmploye @default(ACTIF)
  typeContrat TypeContrat   @default(CDI)

  // Dates importantes
  dateEmbauche DateTime
  dateFin      DateTime? // Date de fin si contrat CDD ou départ

  // Salaire et compensation
  salaireBrut Decimal @db.Decimal(10, 2)
  devise      String  @default("EUR")

  // Horaires et planning
  heuresHebdo  Int?    @default(35) // Heures de travail par semaine
  joursTravail String? // Jours de travail (ex: "Lun-Ven")

  // Documents et notes
  notes String? @db.Text

  // Compétences et qualifications
  competences String? @db.Text // JSON array de compétences

  // Congés
  congesRestants Int @default(25) // Jours de congés restants
  congesPris     Int @default(0) // Jours de congés pris cette année

  // Relation avec User (optionnel - si l'employé a un compte utilisateur)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String? @unique

  // Relations pour système immobilier
  mandatsImmo     MandatImmobilier[] @relation("MandatAgent")
  visitesImmo     VisiteImmobilier[] @relation("VisiteAgent")
  estimationsImmo EstimationBien[]   @relation("EstimationAgent")
  leadsImmo       LeadPortail[]      @relation("LeadAgentResponsable")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entrepriseId, email])
  @@index([entrepriseId])
  @@index([email])
  @@index([statut])
  @@index([dateEmbauche])
}

// ============================================
// WAITLIST (Liste d'attente pré-lancement)
