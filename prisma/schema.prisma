  PAC_AIR_AIR // Air-to-air heat pump
  PAC_AIR_EAU // Air-to-water heat pump
  PAC_GEOTHERMIQUE // Geothermal heat pump
  CLIMATISATION // Air conditioning
  RADIATEUR // Radiator
  PLANCHER_CHAUFFANT // Underfloor heating
  CHAUFFE_EAU // Water heater (gas/electric)
  BALLON_THERMODYNAMIQUE // Thermodynamic water heater
  THERMOSTAT // Thermostat/smart thermostat
  VASE_EXPANSION // Expansion vessel
  CIRCULATEUR // Circulation pump

  // === MENUISERIE ===
  FENETRE // Window
  PORTE_INTERIEURE // Interior door
  PORTE_ENTREE // Entry door
  PORTE_GARAGE // Garage door
  PORTE_BLINDEE // Armored/security door
  VOLET_ROULANT // Roller shutter
  VOLET_BATTANT // Hinged shutter
  PERSIENNE // Louvered shutter
  VELUX // Roof window (skylight)
  BAIE_VITREE // Sliding glass door
  PARQUET // Hardwood floor
  ESCALIER // Staircase
