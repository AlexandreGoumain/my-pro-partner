# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="sk-..."

# Upstash Redis (for rate limiting)
# Get from https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Encryption (for conversation encryption)
# Generate with: openssl rand -base64 32
CONVERSATION_ENCRYPTION_KEY="..."

# Email (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@resend.dev"  # Or your verified domain email
RESEND_FROM_NAME="Your Company Name"

# Client Portal JWT (optional, uses NEXTAUTH_SECRET if not set)
CLIENT_JWT_SECRET="your-client-jwt-secret-here"

# Stripe Payment System
STRIPE_SECRET_KEY="sk_test_..."  # Get from https://dashboard.stripe.com/test/apikeys
STRIPE_WEBHOOK_SECRET="whsec_..."  # Get after setting up webhook
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Change to your production URL

# Stripe Subscription Price IDs (for recurring billing)
# You need to create these in Stripe Dashboard > Products
# See docs/STRIPE_SUBSCRIPTIONS_SETUP.md for detailed instructions
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_ANNUAL="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_ANNUAL="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_ANNUAL="price_..."

# Optional: Product IDs (for reference)
STRIPE_PRODUCT_STARTER="prod_..."
STRIPE_PRODUCT_PRO="prod_..."
STRIPE_PRODUCT_ENTERPRISE="prod_..."

# Stripe Setup Instructions:
# 1. Create account on https://dashboard.stripe.com
# 2. Get your API keys from Developers > API keys
# 3. Set up webhook:
#    - Go to Developers > Webhooks
#    - Add endpoint: https://your-domain.com/api/webhooks/stripe
#    - Select these events:
#      * checkout.session.completed (for one-time payments & subscriptions)
#      * customer.subscription.created
#      * customer.subscription.updated
#      * customer.subscription.deleted
#      * customer.subscription.trial_will_end
#      * invoice.paid
#      * invoice.payment_failed
#    - Copy the webhook signing secret
# 4. Create subscription products and prices (see docs/STRIPE_SUBSCRIPTIONS_SETUP.md)
# 5. Test with card: 4242 4242 4242 4242
