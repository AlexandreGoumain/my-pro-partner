# ================================
# STAGING ENVIRONMENT (.env.staging)
# For: staging.mypropartner.fr
# ================================

# Database - Staging (separate from production)
DATABASE_URL="postgresql://erp_useradmin_thebest:PASSWORD@localhost:5432/erp_artisan_staging?schema=public"

# NextAuth - Staging
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-staging-nextauth-secret-here"
NEXTAUTH_URL="https://staging.mypropartner.fr"

# App URL - Staging
NEXT_PUBLIC_APP_URL="https://staging.mypropartner.fr"

# OpenAI (same as production, or use separate key for testing)
OPENAI_API_KEY="sk-..."

# Upstash Redis (for rate limiting)
# Can use same as production or separate instance
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Encryption (for conversation encryption)
# Generate with: openssl rand -base64 32
CONVERSATION_ENCRYPTION_KEY="..."

# Email (Resend) - Use test domain or same as production
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="My Pro Partner (Staging)"

# Client Portal JWT
# Generate with: openssl rand -base64 32
CLIENT_JWT_SECRET="your-staging-client-jwt-secret-here"

# ================================
# STRIPE - TEST MODE ONLY
# Use sk_test_* keys, NEVER sk_live_* in staging
# ================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Subscription Price IDs (TEST mode)
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_ANNUAL="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_ANNUAL="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_ANNUAL="price_..."

# Optional: Product IDs (TEST mode)
STRIPE_PRODUCT_STARTER="prod_..."
STRIPE_PRODUCT_PRO="prod_..."
STRIPE_PRODUCT_ENTERPRISE="prod_..."

# ================================
# STAGING WEBHOOK SETUP
# ================================
# 1. Go to Stripe Dashboard > Developers > Webhooks (TEST mode)
# 2. Add endpoint: https://staging.mypropartner.fr/api/webhooks/stripe
# 3. Select events:
#    * checkout.session.completed
#    * customer.subscription.created
#    * customer.subscription.updated
#    * customer.subscription.deleted
#    * customer.subscription.trial_will_end
#    * invoice.paid
#    * invoice.payment_failed
# 4. Copy the webhook signing secret above
